<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral surface/text scale; views reference these instead of ad-hoc hex shades. -->
    <Color x:Key="BgColor">#0B0D16</Color>
    <Color x:Key="SurfaceColor">#131524</Color>
    <Color x:Key="Surface2Color">#1A1D30</Color>
    <Color x:Key="Surface3Color">#22263C</Color>
    <Color x:Key="BorderColor">#2C3150</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextSubtleColor">#64748B</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />

    <!-- Fluent's checked toggle uses the system accent (blue); keep it on the app violet. -->
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#7C3AED" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#8B5CF6" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#6D28D9" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#F1F5F9" />

    <FontFamily x:Key="HeadingFont">avares://GameAnalytics.Desktop/Assets/Fonts#Russo One</FontFamily>

    <!-- Icons (Material Design Icons, 24x24) replacing emoji glyphs. -->
    <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
