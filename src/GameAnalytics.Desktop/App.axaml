<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameAnalytics.Desktop.App"
             xmlns:local="using:GameAnalytics.Desktop"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GameAnalytics.Desktop/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Russo One ships a single regular weight; let it render as designed. -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style Selector="PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <!-- Buttons here mostly use a fixed Height; keep their label centred instead of top-aligned. -->
        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Fluent swaps the background to its own grey on hover/press, which erased the app's
             coloured buttons. Keep each button's own colours and signal hover with opacity. -->
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
            <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Application.Styles>
</Application>
