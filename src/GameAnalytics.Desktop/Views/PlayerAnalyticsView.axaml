<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GameAnalytics.Desktop.ViewModels"
             xmlns:conv="using:GameAnalytics.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="GameAnalytics.Desktop.Views.PlayerAnalyticsView"
             x:DataType="vm:PlayerAnalyticsViewModel">

    <UserControl.Resources>
        <conv:BitmapAssetValueConverter x:Key="BitmapAssetConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Button Hover Animation -->
        <Style Selector="Button.action-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- Match Card Hover Animation -->
        <Style Selector="Border.match-card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Border.match-card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.01)" />
            <Setter Property="BorderBrush" Value="#C8AA6E" />
        </Style>

        <!-- Player Nickname Link Button -->
        <Style Selector="Button.player-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.player-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.player-link:pointerover TextBlock">
            <Setter Property="Foreground" Value="#0AC8B9" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="18">

            <!-- 1. RIOT ID SEARCH & REGION CONSOLE -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#1E283A"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <!-- Title Bar -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="🔍 ПОШУК ГРАВЦЯ У СИСТЕМІ RIOT ID"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="#C8AA6E"
                                       LetterSpacing="1.2" />
                            <TextBlock Text="Введіть ігрове ім'я, тег після # та оберіть ігровий сервер (EUW, EUNE, NA, KR тощо)"
                                       FontSize="12"
                                       Foreground="#8A93A5" />
                        </StackPanel>

                        <!-- API Status Pill -->
                        <Border Grid.Column="1"
                                Background="#091428"
                                BorderBrush="#252D3D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApiStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#0AC8B9" />
                        </Border>
                    </Grid>

                    <!-- Search Input Row -->
                    <Grid ColumnDefinitions="220, *, 20, 110, Auto" RowDefinitions="Auto">
                        <!-- Server Region Dropdown -->
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableRegions}"
                                  SelectedItem="{Binding SelectedRegion}"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Margin="0,0,10,0" />

                        <!-- Game Name Input -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding GameName}"
                                 PlaceholderText="Ім'я гравця (підтримує: Qu4dyz#qu4)"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center" />

                        <!-- Hash Separator -->
                        <TextBlock Grid.Column="2"
                                   Text="#"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#C8AA6E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Tag Line Input -->
                        <TextBox Grid.Column="3"
                                 Text="{Binding TagLine}"
                                 PlaceholderText="Тег (qu4)"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0" />

                        <!-- Search Button -->
                        <Button Grid.Column="4"
                                Command="{Binding SearchPlayerCommand}"
                                Classes="action-btn"
                                Content="⚡ ЗНАЙТИ ГРАВЦЯ"
                                Height="40"
                                Background="#0AC8B9"
                                Foreground="#010A13"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="20,0"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Demo Mode Options & API Key Bar -->
                    <Border Background="#091428"
                            CornerRadius="6"
                            Padding="12,8"
                            BorderBrush="#1E283A"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, 160, *, Auto">
                            <!-- Demo Tier Selector -->
                            <TextBlock Grid.Column="0"
                                       Text="🎮 Бажаний ранг у демо-режимі:"
                                       FontSize="12"
                                       Foreground="#8A93A5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTiers}"
                                      SelectedItem="{Binding SelectedDemoTier}"
                                      Height="30"
                                      FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,20,0" />

                            <!-- Quick API Key Input -->
                            <TextBox Grid.Column="2"
                                     Text="{Binding ApiKeyInput}"
                                     PlaceholderText="Введіть Riot API Key (RGAPI-...) для отримання реальної статистики"
                                     Height="30"
                                     FontSize="11"
                                     PasswordChar="●"
                                     Margin="0,0,8,0" />

                            <Button Grid.Column="3"
                                    Command="{Binding SaveApiKeyCommand}"
                                    Classes="action-btn"
                                    Content="💾 Застосувати ключ"
                                    Height="30"
                                    Background="#1E283A"
                                    Foreground="#F0E6D2"
                                    FontSize="11"
                                    Padding="10,0"
                                    Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#C8AA6E" />
                </StackPanel>
            </Border>

            <!-- 2. PLAYER PROFILE HEXTECH CARD (Rendered when profile is loaded) -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="22"
                    BorderBrush="#252D3D"
                    BorderThickness="1"
                    IsVisible="{Binding Summoner, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: Profile Icon with Level Badge -->
                    <Grid Grid.Column="0" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Border Width="88" Height="88"
                                CornerRadius="44"
                                ClipToBounds="True"
                                Background="#091428"
                                BorderBrush="{Binding TierBadgeColor}"
                                BorderThickness="3">
                            <Image Source="{Binding Summoner.ProfileIconUrl, Converter={StaticResource BitmapAssetConverter}}"
                                   Width="88" Height="88"
                                   Stretch="UniformToFill" />
                        </Border>

                        <!-- Level Tag floating at bottom -->
                        <Border Background="#091428"
                                BorderBrush="{Binding TierBadgeColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-8">
                            <TextBlock Text="{Binding Summoner.SummonerLevel, StringFormat='Рівень {0}'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- Center: Identity & Server -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summoner.GameName}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2" />
                            <TextBlock Text="{Binding Summoner.TagLine, StringFormat='#{0}'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0AC8B9" />
                            <Border Background="#091428" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" BorderBrush="#252D3D" BorderThickness="1">
                                <TextBlock Text="{Binding SelectedRegion.DisplayName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C8AA6E" />
                            </Border>
                        </StackPanel>

                        <!-- Ranked Tier & LP -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{Binding TierBadgeColor}"
                                    CornerRadius="4"
                                    Padding="10,4">
                                <TextBlock Text="{Binding Summoner.Tier, StringFormat='{}{0}'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#010A13" />
                            </Border>

                            <TextBlock Text="{Binding Summoner.Rank}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="{Binding Summoner.LeaguePoints, StringFormat='{}{0} LP'}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#C8AA6E"
                                       VerticalAlignment="Center" />

                            <Border Background="#091428" CornerRadius="4" Padding="6,2" BorderBrush="#252D3D" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Ranked Solo/Duo 5v5"
                                           FontSize="11"
                                           Foreground="#8A93A5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: WinRate & Record Badge -->
                    <Border Grid.Column="2"
                            Background="#091428"
                            CornerRadius="8"
                            Padding="18,14"
                            BorderBrush="#252D3D"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Summoner.WinRate, StringFormat='Вінрейт: {0}%'}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0AC8B9"
                                       HorizontalAlignment="Right" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Summoner.Wins, StringFormat='{}{0}W'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#5383E8" />
                                <TextBlock Text="{Binding Summoner.Losses, StringFormat='{}{0}L'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#E84057" />
                                <TextBlock Text="{Binding Summoner.TotalGames, StringFormat='({0} матчів)'}"
                                           FontSize="12"
                                           Foreground="#8A93A5" />
                            </StackPanel>

                            <!-- Win/Loss Ratio Progress Bar -->
                            <ProgressBar Value="{Binding Summoner.Wins}"
                                         Minimum="0"
                                         Maximum="{Binding Summoner.TotalGames}"
                                         Height="6"
                                         Width="150"
                                         Foreground="#5383E8"
                                         Background="#E84057"
                                         Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.5 RECENT GAMES SESSION OVERVIEW (OP.GG style) -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="18"
                    BorderBrush="#1E283A"
                    BorderThickness="1"
                    IsVisible="{Binding HasSessionData}">
                <Grid ColumnDefinitions="200, 200, *, 170">
                    <!-- Col 0: WinRate & Record -->
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="СТАТИСТИКА СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <TextBlock Text="{Binding SessionRecordText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#F0E6D2" />
                        <TextBlock Text="{Binding SessionWinRate, StringFormat='{}{0:F1}% WR'}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0AC8B9" />
                        <!-- Mini Win/Loss Bar -->
                        <ProgressBar Value="{Binding SessionWins}"
                                     Minimum="0"
                                     Maximum="{Binding SessionTotalGames}"
                                     Height="5"
                                     Width="160"
                                     Foreground="#5383E8"
                                     Background="#E84057"
                                     Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Col 1: Average KDA & Kill Participation -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="СЕРЕДНІЙ KDA СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <TextBlock Text="{Binding AvgKdaNumbers}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding SessionKdaRatioText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding SessionKdaRatioColor}" />
                            </Border>
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding AvgKpText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C8AA6E" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Col 2: Top 3 Most Played Champions -->
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="НАЙЧАСТІШІ ЧЕМПІОНИ СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <ItemsControl ItemsSource="{Binding TopRecentChampions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentChampionStatViewModel">
                                    <Grid ColumnDefinitions="32, *" VerticalAlignment="Center">
                                        <!-- Champion Avatar -->
                                        <Border Grid.Column="0"
                                                Width="30" Height="30"
                                                CornerRadius="15"
                                                ClipToBounds="True"
                                                Background="#091428"
                                                BorderBrush="#252D3D"
                                                BorderThickness="1.5">
                                            <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}"
                                                   Width="30" Height="30"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <!-- Champion Details -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                            <TextBlock Text="{Binding ChampionName}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#F0E6D2" />
                                            <TextBlock Text="{Binding WinRateText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding WinRateColor}" />
                                            <TextBlock Text="{Binding KdaText}"
                                                       FontSize="10"
                                                       Foreground="#8A93A5" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Col 3: Preferred Role -->
                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="ПРІОРИТЕТНА ЛІНІЯ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1"
                                   HorizontalAlignment="Right" />
                        <Border Background="#091428"
                                CornerRadius="6"
                                Padding="12,6"
                                BorderBrush="#252D3D"
                                BorderThickness="1"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PreferredRoleText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2.6 AI PLAYER MOMENTUM & TILT DETECTOR (ML Feature) -->
            <Border Background="#101726"
                    CornerRadius="10"
                    Padding="18,14"
                    BorderBrush="#1F2D44"
                    BorderThickness="1"
                    IsVisible="{Binding HasMomentumData}">
                <Grid ColumnDefinitions="260, 1, *">
                    <!-- Left: Gauge & Score -->
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🤖 ШІ-ОЦІНКА ФОРМИ (MOMENTUM)"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#C8AA6E"
                                       LetterSpacing="1.1" />
                            <Border Background="#091428" CornerRadius="4" Padding="6,2" BorderBrush="#0AC8B9" BorderThickness="1">
                                <TextBlock Text="ML.NET" FontSize="9" Foreground="#0AC8B9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto, *">
                            <!-- Momentum Score Number -->
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{Binding MomentumScoreText}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{Binding MomentumStatusColor}" />
                                <TextBlock Text="{Binding MomentumStatusText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding MomentumStatusColor}" />
                            </StackPanel>

                            <!-- Mini Metrics Stack -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                <Border Background="#141E2F" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding MomentumStreakText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#F0E6D2" />
                                </Border>
                                <Border Background="#141E2F" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding NextGameWinChanceText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0AC8B9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Momentum Progress Bar -->
                        <ProgressBar Value="{Binding MomentumScore}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Foreground="{Binding MomentumStatusColor}"
                                     Background="#1F2633" />
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Width="1" Fill="#1F2D44" Margin="0,2,16,2" />

                    <!-- Right: AI Recommendation Box -->
                    <Grid Grid.Column="2" ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="💡" FontSize="22" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="АНАЛІТИЧНА РЕКОМЕНДАЦІЯ ШІ:"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8A93A5"
                                       LetterSpacing="1.0" />
                            <TextBlock Text="{Binding AiAdviceText}"
                                       FontSize="12"
                                       Foreground="#F0E6D2"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. RECENT MATCHES SECTION HEADER & QUEUE FILTER -->
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0"
                           Text="ІСТОРІЯ ОСТАННІХ МАТЧІВ"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#C8AA6E"
                           LetterSpacing="1.2"
                           VerticalAlignment="Center" />

                <!-- Queue Filter ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableQueueFilters}"
                          SelectedItem="{Binding SelectedQueueFilter}"
                          Height="32"
                          Width="140"
                          FontSize="11"
                          VerticalContentAlignment="Center"
                          Margin="0,0,12,0" />

                <!-- Match Count Pill -->
                <Border Grid.Column="2"
                        Background="#121824"
                        CornerRadius="4"
                        Padding="10,4"
                        BorderBrush="#252D3D"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredRecentMatches.Count, StringFormat='Показано матчів: {0}'}"
                               FontSize="11"
                               Foreground="#8A93A5" />
                </Border>
            </Grid>

            <!-- 4. MODERN MATCH CARDS LIST (OP.GG / U.GG style with Accordion) -->
            <ItemsControl ItemsSource="{Binding FilteredRecentMatches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerMatchItemViewModel">
                        <Border Classes="match-card"
                                Background="{Binding ResultBgColor}"
                                CornerRadius="8"
                                Margin="0,0,0,10"
                                BorderThickness="1"
                                BorderBrush="{Binding ResultBorderColor}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="6, *">
                                <!-- Colored left accent bar -->
                                <Border Grid.Column="0" Background="{Binding AccentBarColor}" />

                                <!-- Card Vertical Content (Compact Row + Accordion Details) -->
                                <StackPanel Grid.Column="1">
                                    <!-- Top Main Row -->
                                    <Grid ColumnDefinitions="110, 165, 155, 110, 110, *, 75" Margin="14,12">
                                        <!-- Col 0: Match Outcome & Time -->
                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameModeText}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="#F0E6D2" />
                                            <TextBlock Text="{Binding ResultText}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{Binding ResultColor}" />
                                            <TextBlock Text="{Binding FormattedDuration}"
                                                       FontSize="10"
                                                       Foreground="#8A93A5" />
                                            <TextBlock Text="{Binding FormattedTimeAgo}"
                                                       FontSize="10"
                                                       Foreground="#657182" />
                                        </StackPanel>

                                        <!-- Col 1: Champion & Level & Role -->
                                        <Grid Grid.Column="1" ColumnDefinitions="48, *" VerticalAlignment="Center">
                                            <!-- Champion Avatar with Level Badge -->
                                            <Grid Grid.Column="0" Width="44" Height="44">
                                                <Border Width="44" Height="44"
                                                        CornerRadius="22"
                                                        ClipToBounds="True"
                                                        Background="#091428"
                                                        BorderBrush="{Binding AccentBarColor}"
                                                        BorderThickness="2">
                                                    <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}"
                                                           Width="44" Height="44"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <!-- Champ Level Badge -->
                                                <Border Background="#121824"
                                                        BorderBrush="{Binding AccentBarColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding ChampLevelText}"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Champion Name & Position Pill -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding ChampionName}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="#F0E6D2" />
                                                <Border Background="#091428"
                                                        CornerRadius="4"
                                                        Padding="5,2"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#252D3D"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <TextBlock Text="{Binding PositionIcon}" FontSize="10" />
                                                        <TextBlock Text="{Binding PositionName}" FontSize="9" Foreground="#8A93A5" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Col 2: KDA, Ratio & Kill Participation -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding KdaText}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#FFFFFF" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Background="#091428"
                                                        CornerRadius="4"
                                                        Padding="5,2"
                                                        BorderBrush="#252D3D"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding KdaRatioText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding KdaRatioColor}" />
                                                </Border>
                                                <Border Background="#091428"
                                                        CornerRadius="4"
                                                        Padding="5,2"
                                                        BorderBrush="#252D3D"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding KillParticipationText}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding KillParticipationColor}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 3: CS, Gold & Damage -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding CsText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F0E6D2" />
                                            <TextBlock Text="{Binding DamageText}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#E84057" />
                                            <TextBlock Text="{Binding GoldText}"
                                                       FontSize="10"
                                                       Foreground="#C8AA6E" />
                                        </StackPanel>

                                        <!-- Col 4: Player Items Grid (6 items + Trinket) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="3" HorizontalAlignment="Center">
                                            <!-- Top row: 3 items + trinket -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Border Width="22" Height="22" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ItemSlot0.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding ItemSlot0.HasItem}" />
                                                </Border>
                                                <Border Width="22" Height="22" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ItemSlot1.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding ItemSlot1.HasItem}" />
                                                </Border>
                                                <Border Width="22" Height="22" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ItemSlot2.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding ItemSlot2.HasItem}" />
                                                </Border>
                                                <!-- Trinket -->
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#141B28" BorderBrush="#C8AA6E" BorderThickness="1" ClipToBounds="True" Margin="2,0,0,0">
                                                    <Image Source="{Binding PlayerTrinket.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding PlayerTrinket.HasItem}" />
                                                </Border>
                                            </StackPanel>
                                            <!-- Bottom row: 3 items -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Border Width="22" Height="22" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ItemSlot3.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding ItemSlot3.HasItem}" />
                                                </Border>
                                                <Border Width="22" Height="22" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ItemSlot4.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding ItemSlot4.HasItem}" />
                                                </Border>
                                                <Border Width="22" Height="22" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ItemSlot5.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="22" Height="22" Stretch="UniformToFill" IsVisible="{Binding ItemSlot5.HasItem}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 5: 10-Player Team Rosters (Blue vs Red) -->
                                        <Grid Grid.Column="5" ColumnDefinitions="*, *" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <!-- Blue Team -->
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding BlueTeam}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MiniParticipantViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1.5">
                                                            <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True" Background="#091428">
                                                                <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="16" Height="16" Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="10"
                                                                       Foreground="{Binding NameColor}"
                                                                       FontWeight="{Binding NameWeight}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="80"
                                                                       IsVisible="{Binding IsCurrentPlayer}"
                                                                       ToolTip.Tip="{Binding ToolTipText}" />
                                                            <Button Classes="player-link"
                                                                    Command="{Binding SelectPlayerCommand}"
                                                                    CommandParameter="{Binding FullRiotId}"
                                                                    IsVisible="{Binding !IsCurrentPlayer}"
                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="10"
                                                                           Foreground="{Binding NameColor}"
                                                                           FontWeight="{Binding NameWeight}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="80" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Red Team -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding RedTeam}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MiniParticipantViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,1.5">
                                                            <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True" Background="#091428">
                                                                <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="16" Height="16" Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="10"
                                                                       Foreground="{Binding NameColor}"
                                                                       FontWeight="{Binding NameWeight}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="80"
                                                                       IsVisible="{Binding IsCurrentPlayer}"
                                                                       ToolTip.Tip="{Binding ToolTipText}" />
                                                            <Button Classes="player-link"
                                                                    Command="{Binding SelectPlayerCommand}"
                                                                    CommandParameter="{Binding FullRiotId}"
                                                                    IsVisible="{Binding !IsCurrentPlayer}"
                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="10"
                                                                           Foreground="{Binding NameColor}"
                                                                           FontWeight="{Binding NameWeight}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="80" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <!-- Col 6: Accordion Expand Button -->
                                        <Button Grid.Column="6"
                                                Content="{Binding ExpandButtonText}"
                                                Command="{Binding ToggleExpandCommand}"
                                                Foreground="{Binding ExpandButtonColor}"
                                                Background="#091428"
                                                BorderBrush="#252D3D"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Padding="6,4"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Expanded 5v5 Match Details Accordion Panel -->
                                    <Border IsVisible="{Binding IsExpanded}"
                                            Background="#0A0E17"
                                            BorderBrush="{Binding ResultBorderColor}"
                                            BorderThickness="0,1,0,0"
                                            Padding="14,10">
                                        <StackPanel Spacing="10">
                                            <!-- BLUE TEAM TABLE -->
                                            <Border Background="#0F1726" CornerRadius="6" BorderBrush="#1C2B42" BorderThickness="1" Padding="8">
                                                <StackPanel Spacing="4">
                                                    <!-- Team Header -->
                                                    <Grid ColumnDefinitions="220, 85, 130, 110, *" Margin="4,2">
                                                        <TextBlock Grid.Column="0" Text="🔷 СИНЯ КОМАНДА" FontWeight="Bold" FontSize="11" Foreground="#5383E8" />
                                                        <TextBlock Grid.Column="1" Text="KDA" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                        <TextBlock Grid.Column="2" Text="ШКОДА ЧЕМПІОНАМ" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                        <TextBlock Grid.Column="3" Text="ФАРМ / ЗОЛОТО" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                        <TextBlock Grid.Column="4" Text="ПРЕДМЕТИ (6 + ВАРД)" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding BlueTeamDetailed}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DetailedParticipantViewModel">
                                                                <Border Background="#0D131F" CornerRadius="4" Padding="6,4" Margin="0,1">
                                                                    <Grid ColumnDefinitions="220, 85, 130, 110, *">
                                                                        <!-- Player Info with Clickable Link -->
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="#091428" BorderBrush="#252D3D" BorderThickness="1">
                                                                                <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="24" Height="24" Stretch="UniformToFill" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding PositionIcon}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{Binding NameColor}"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="125"
                                                                                       IsVisible="{Binding IsCurrentPlayer}"
                                                                                       ToolTip.Tip="{Binding ToolTipText}" />
                                                                            <Button Classes="player-link"
                                                                                    Command="{Binding SelectPlayerCommand}"
                                                                                    CommandParameter="{Binding FullRiotId}"
                                                                                    IsVisible="{Binding !IsCurrentPlayer}"
                                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="11"
                                                                                           FontWeight="{Binding NameWeight}"
                                                                                           Foreground="{Binding NameColor}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="125" />
                                                                            </Button>
                                                                            <TextBlock Text="{Binding ChampLevelText, StringFormat='lvl {0}'}" FontSize="9" Foreground="#657182" VerticalAlignment="Center" />
                                                                        </StackPanel>

                                                                        <!-- KDA -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                            <TextBlock Text="{Binding KdaText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                            <TextBlock Text="{Binding KdaRatioText}" FontSize="9" Foreground="#8A93A5" />
                                                                        </StackPanel>

                                                                        <!-- Damage bar (strictly bounded) -->
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                                                                            <TextBlock Text="{Binding DamageText}" FontSize="10" FontWeight="Bold" Foreground="#E84057" />
                                                                            <ProgressBar Value="{Binding DamagePercentOfMax}"
                                                                                         Minimum="0"
                                                                                         Maximum="100"
                                                                                         MinWidth="0"
                                                                                         Width="85"
                                                                                         MaxWidth="85"
                                                                                         Height="4"
                                                                                         ClipToBounds="True"
                                                                                         CornerRadius="2"
                                                                                         Foreground="#E84057"
                                                                                         Background="#1F2633"
                                                                                         HorizontalAlignment="Left" />
                                                                        </StackPanel>

                                                                        <!-- Farm & Gold -->
                                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                                                            <TextBlock Text="{Binding CsText, StringFormat='{}{0} CS'}" FontSize="10" Foreground="#F0E6D2" />
                                                                            <TextBlock Text="{Binding GoldText}" FontSize="10" Foreground="#C8AA6E" />
                                                                        </StackPanel>

                                                                        <!-- Items -->
                                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ItemSlotViewModel">
                                                                                        <Border Width="20" Height="20" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                                                            <Image Source="{Binding IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="20" Height="20" Stretch="UniformToFill" IsVisible="{Binding HasItem}" />
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <!-- Trinket -->
                                                                            <Border Width="20" Height="20" CornerRadius="10" Background="#141B28" BorderBrush="#C8AA6E" BorderThickness="1" ClipToBounds="True" Margin="3,0,0,0">
                                                                                <Image Source="{Binding Trinket.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="20" Height="20" Stretch="UniformToFill" IsVisible="{Binding Trinket.HasItem}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- RED TEAM TABLE -->
                                            <Border Background="#1A1116" CornerRadius="6" BorderBrush="#421C27" BorderThickness="1" Padding="8">
                                                <StackPanel Spacing="4">
                                                    <!-- Team Header -->
                                                    <Grid ColumnDefinitions="220, 85, 130, 110, *" Margin="4,2">
                                                        <TextBlock Grid.Column="0" Text="🛑 ЧЕРВОНА КОМАНДА" FontWeight="Bold" FontSize="11" Foreground="#E84057" />
                                                        <TextBlock Grid.Column="1" Text="KDA" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                        <TextBlock Grid.Column="2" Text="ШКОДА ЧЕМПІОНАМ" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                        <TextBlock Grid.Column="3" Text="ФАРМ / ЗОЛОТО" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                        <TextBlock Grid.Column="4" Text="ПРЕДМЕТИ (6 + ВАРД)" FontWeight="Bold" FontSize="10" Foreground="#8A93A5" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding RedTeamDetailed}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:DetailedParticipantViewModel">
                                                                <Border Background="#160E13" CornerRadius="4" Padding="6,4" Margin="0,1">
                                                                    <Grid ColumnDefinitions="220, 85, 130, 110, *">
                                                                        <!-- Player Info with Clickable Link -->
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Background="#091428" BorderBrush="#252D3D" BorderThickness="1">
                                                                                <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="24" Height="24" Stretch="UniformToFill" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding PositionIcon}" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{Binding NameColor}"
                                                                                       VerticalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       MaxWidth="125"
                                                                                       IsVisible="{Binding IsCurrentPlayer}"
                                                                                       ToolTip.Tip="{Binding ToolTipText}" />
                                                                            <Button Classes="player-link"
                                                                                    Command="{Binding SelectPlayerCommand}"
                                                                                    CommandParameter="{Binding FullRiotId}"
                                                                                    IsVisible="{Binding !IsCurrentPlayer}"
                                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="11"
                                                                                           FontWeight="{Binding NameWeight}"
                                                                                           Foreground="{Binding NameColor}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="125" />
                                                                            </Button>
                                                                            <TextBlock Text="{Binding ChampLevelText, StringFormat='lvl {0}'}" FontSize="9" Foreground="#657182" VerticalAlignment="Center" />
                                                                        </StackPanel>

                                                                        <!-- KDA -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                            <TextBlock Text="{Binding KdaText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                            <TextBlock Text="{Binding KdaRatioText}" FontSize="9" Foreground="#8A93A5" />
                                                                        </StackPanel>

                                                                        <!-- Damage bar (strictly bounded) -->
                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                                                                            <TextBlock Text="{Binding DamageText}" FontSize="10" FontWeight="Bold" Foreground="#E84057" />
                                                                            <ProgressBar Value="{Binding DamagePercentOfMax}"
                                                                                         Minimum="0"
                                                                                         Maximum="100"
                                                                                         MinWidth="0"
                                                                                         Width="85"
                                                                                         MaxWidth="85"
                                                                                         Height="4"
                                                                                         ClipToBounds="True"
                                                                                         CornerRadius="2"
                                                                                         Foreground="#E84057"
                                                                                         Background="#1F2633"
                                                                                         HorizontalAlignment="Left" />
                                                                        </StackPanel>

                                                                        <!-- Farm & Gold -->
                                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                                                            <TextBlock Text="{Binding CsText, StringFormat='{}{0} CS'}" FontSize="10" Foreground="#F0E6D2" />
                                                                            <TextBlock Text="{Binding GoldText}" FontSize="10" Foreground="#C8AA6E" />
                                                                        </StackPanel>

                                                                        <!-- Items -->
                                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="vm:ItemSlotViewModel">
                                                                                        <Border Width="20" Height="20" CornerRadius="3" Background="#141B28" BorderBrush="#253044" BorderThickness="1" ClipToBounds="True">
                                                                                            <Image Source="{Binding IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="20" Height="20" Stretch="UniformToFill" IsVisible="{Binding HasItem}" />
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <!-- Trinket -->
                                                                            <Border Width="20" Height="20" CornerRadius="10" Background="#141B28" BorderBrush="#C8AA6E" BorderThickness="1" ClipToBounds="True" Margin="3,0,0,0">
                                                                                <Image Source="{Binding Trinket.IconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="20" Height="20" Stretch="UniformToFill" IsVisible="{Binding Trinket.HasItem}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. LOAD MORE MATCHES BUTTON -->
            <Button Command="{Binding LoadMoreMatchesCommand}"
                    IsEnabled="{Binding !IsLoadingMore}"
                    IsVisible="{Binding CanLoadMore}"
                    Classes="action-btn"
                    Height="42"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#121824"
                    BorderBrush="#252D3D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    Margin="0,4,0,20">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IsLoadingMore, Converter={x:Null}, FallbackValue='ЗАВАНТАЖИТИ ЩЕ 5 МАТЧІВ'}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#0AC8B9"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
