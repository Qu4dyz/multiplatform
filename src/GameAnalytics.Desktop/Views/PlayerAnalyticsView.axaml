<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GameAnalytics.Desktop.ViewModels"
             xmlns:conv="using:GameAnalytics.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="GameAnalytics.Desktop.Views.PlayerAnalyticsView"
             x:DataType="vm:PlayerAnalyticsViewModel">

    <UserControl.Resources>
        <conv:BitmapAssetValueConverter x:Key="BitmapAssetConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Button Hover Animation -->
        <Style Selector="Button.action-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- Match Card Hover Animation -->
        <Style Selector="Border.match-card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Border.match-card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.01)" />
            <Setter Property="BorderBrush" Value="#C8AA6E" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="18">

            <!-- 1. RIOT ID SEARCH & REGION CONSOLE -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#1E283A"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <!-- Title Bar -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="🔍 ПОШУК ГРАВЦЯ У СИСТЕМІ RIOT ID"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="#C8AA6E"
                                       LetterSpacing="1.2" />
                            <TextBlock Text="Введіть ігрове ім'я, тег після # та оберіть ігровий сервер (EUW, EUNE, NA, KR тощо)"
                                       FontSize="12"
                                       Foreground="#8A93A5" />
                        </StackPanel>

                        <!-- API Status Pill -->
                        <Border Grid.Column="1"
                                Background="#091428"
                                BorderBrush="#252D3D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,6"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApiStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#0AC8B9" />
                        </Border>
                    </Grid>

                    <!-- Search Input Row -->
                    <Grid ColumnDefinitions="220, *, 20, 110, Auto" RowDefinitions="Auto">
                        <!-- Server Region Dropdown -->
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableRegions}"
                                  SelectedItem="{Binding SelectedRegion}"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Margin="0,0,10,0" />

                        <!-- Game Name Input -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding GameName}"
                                 PlaceholderText="Ім'я гравця (підтримує: Qu4dyz#qu4)"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center" />

                        <!-- Hash Separator -->
                        <TextBlock Grid.Column="2"
                                   Text="#"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#C8AA6E"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Tag Line Input -->
                        <TextBox Grid.Column="3"
                                 Text="{Binding TagLine}"
                                 PlaceholderText="Тег (qu4)"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0" />

                        <!-- Search Button -->
                        <Button Grid.Column="4"
                                Command="{Binding SearchPlayerCommand}"
                                Classes="action-btn"
                                Content="⚡ ЗНАЙТИ ГРАВЦЯ"
                                Height="40"
                                Background="#0AC8B9"
                                Foreground="#010A13"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="20,0"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Demo Mode Options & API Key Bar -->
                    <Border Background="#091428"
                            CornerRadius="6"
                            Padding="12,8"
                            BorderBrush="#1E283A"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, 160, *, Auto">
                            <!-- Demo Tier Selector -->
                            <TextBlock Grid.Column="0"
                                       Text="🎮 Бажаний ранг у демо-режимі:"
                                       FontSize="12"
                                       Foreground="#8A93A5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTiers}"
                                      SelectedItem="{Binding SelectedDemoTier}"
                                      Height="30"
                                      FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,20,0" />

                            <!-- Quick API Key Input -->
                            <TextBox Grid.Column="2"
                                     Text="{Binding ApiKeyInput}"
                                     PlaceholderText="Введіть Riot API Key (RGAPI-...) для отримання реальної статистики"
                                     Height="30"
                                     FontSize="11"
                                     PasswordChar="●"
                                     Margin="0,0,8,0" />

                            <Button Grid.Column="3"
                                    Command="{Binding SaveApiKeyCommand}"
                                    Classes="action-btn"
                                    Content="💾 Застосувати ключ"
                                    Height="30"
                                    Background="#1E283A"
                                    Foreground="#F0E6D2"
                                    FontSize="11"
                                    Padding="10,0"
                                    Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#C8AA6E" />
                </StackPanel>
            </Border>

            <!-- 2. PLAYER PROFILE HEXTECH CARD (Rendered when profile is loaded) -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="22"
                    BorderBrush="#252D3D"
                    BorderThickness="1"
                    IsVisible="{Binding Summoner, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: Profile Icon with Level Badge -->
                    <Grid Grid.Column="0" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Border Width="88" Height="88"
                                CornerRadius="44"
                                ClipToBounds="True"
                                Background="#091428"
                                BorderBrush="{Binding TierBadgeColor}"
                                BorderThickness="3">
                            <Image Source="{Binding Summoner.ProfileIconUrl, Converter={StaticResource BitmapAssetConverter}}"
                                   Width="88" Height="88"
                                   Stretch="UniformToFill" />
                        </Border>

                        <!-- Level Tag floating at bottom -->
                        <Border Background="#091428"
                                BorderBrush="{Binding TierBadgeColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-8">
                            <TextBlock Text="{Binding Summoner.SummonerLevel, StringFormat='Рівень {0}'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- Center: Identity & Server -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summoner.GameName}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2" />
                            <TextBlock Text="{Binding Summoner.TagLine, StringFormat='#{0}'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#0AC8B9" />
                            <Border Background="#091428" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" BorderBrush="#252D3D" BorderThickness="1">
                                <TextBlock Text="{Binding SelectedRegion.DisplayName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C8AA6E" />
                            </Border>
                        </StackPanel>

                        <!-- Ranked Tier & LP -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{Binding TierBadgeColor}"
                                    CornerRadius="4"
                                    Padding="10,4">
                                <TextBlock Text="{Binding Summoner.Tier, StringFormat='{}{0}'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#010A13" />
                            </Border>

                            <TextBlock Text="{Binding Summoner.Rank}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="{Binding Summoner.LeaguePoints, StringFormat='{}{0} LP'}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#C8AA6E"
                                       VerticalAlignment="Center" />

                            <Border Background="#091428" CornerRadius="4" Padding="6,2" BorderBrush="#252D3D" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Ranked Solo/Duo 5v5"
                                           FontSize="11"
                                           Foreground="#8A93A5"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: WinRate & Record Badge -->
                    <Border Grid.Column="2"
                            Background="#091428"
                            CornerRadius="8"
                            Padding="18,14"
                            BorderBrush="#252D3D"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Summoner.WinRate, StringFormat='Вінрейт: {0}%'}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0AC8B9"
                                       HorizontalAlignment="Right" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Summoner.Wins, StringFormat='{}{0}W'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#5383E8" />
                                <TextBlock Text="{Binding Summoner.Losses, StringFormat='{}{0}L'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#E84057" />
                                <TextBlock Text="{Binding Summoner.TotalGames, StringFormat='({0} матчів)'}"
                                           FontSize="12"
                                           Foreground="#8A93A5" />
                            </StackPanel>

                            <!-- Win/Loss Ratio Progress Bar -->
                            <ProgressBar Value="{Binding Summoner.Wins}"
                                         Minimum="0"
                                         Maximum="{Binding Summoner.TotalGames}"
                                         Height="6"
                                         Width="150"
                                         Foreground="#5383E8"
                                         Background="#E84057"
                                         Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.5 RECENT GAMES SESSION OVERVIEW (OP.GG style) -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="18"
                    BorderBrush="#1E283A"
                    BorderThickness="1"
                    IsVisible="{Binding HasSessionData}">
                <Grid ColumnDefinitions="200, 200, *, 170">
                    <!-- Col 0: WinRate & Record -->
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="СТАТИСТИКА СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <TextBlock Text="{Binding SessionRecordText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#F0E6D2" />
                        <TextBlock Text="{Binding SessionWinRate, StringFormat='{}{0:F1}% WR'}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#0AC8B9" />
                        <!-- Mini Win/Loss Bar -->
                        <ProgressBar Value="{Binding SessionWins}"
                                     Minimum="0"
                                     Maximum="{Binding SessionTotalGames}"
                                     Height="5"
                                     Width="160"
                                     Foreground="#5383E8"
                                     Background="#E84057"
                                     Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Col 1: Average KDA & Kill Participation -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="СЕРЕДНІЙ KDA СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <TextBlock Text="{Binding AvgKdaNumbers}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding SessionKdaRatioText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding SessionKdaRatioColor}" />
                            </Border>
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding AvgKpText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C8AA6E" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Col 2: Top 3 Most Played Champions -->
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="НАЙЧАСТІШІ ЧЕМПІОНИ СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <ItemsControl ItemsSource="{Binding TopRecentChampions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentChampionStatViewModel">
                                    <Grid ColumnDefinitions="32, *" VerticalAlignment="Center">
                                        <!-- Champion Avatar -->
                                        <Border Grid.Column="0"
                                                Width="30" Height="30"
                                                CornerRadius="15"
                                                ClipToBounds="True"
                                                Background="#091428"
                                                BorderBrush="#252D3D"
                                                BorderThickness="1.5">
                                            <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}"
                                                   Width="30" Height="30"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <!-- Champion Details -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                            <TextBlock Text="{Binding ChampionName}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#F0E6D2" />
                                            <TextBlock Text="{Binding WinRateText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding WinRateColor}" />
                                            <TextBlock Text="{Binding KdaText}"
                                                       FontSize="10"
                                                       Foreground="#8A93A5" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Col 3: Preferred Role -->
                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="ПРІОРИТЕТНА ЛІНІЯ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1"
                                   HorizontalAlignment="Right" />
                        <Border Background="#091428"
                                CornerRadius="6"
                                Padding="12,6"
                                BorderBrush="#252D3D"
                                BorderThickness="1"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PreferredRoleText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. RECENT MATCHES SECTION HEADER & QUEUE FILTER -->
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0"
                           Text="ІСТОРІЯ ОСТАННІХ МАТЧІВ"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#C8AA6E"
                           LetterSpacing="1.2"
                           VerticalAlignment="Center" />

                <!-- Queue Filter ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableQueueFilters}"
                          SelectedItem="{Binding SelectedQueueFilter}"
                          Height="32"
                          Width="140"
                          FontSize="11"
                          VerticalContentAlignment="Center"
                          Margin="0,0,12,0" />

                <!-- Match Count Pill -->
                <Border Grid.Column="2"
                        Background="#121824"
                        CornerRadius="4"
                        Padding="10,4"
                        BorderBrush="#252D3D"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredRecentMatches.Count, StringFormat='Показано матчів: {0}'}"
                               FontSize="11"
                               Foreground="#8A93A5" />
                </Border>
            </Grid>

            <!-- 4. MODERN MATCH CARDS LIST (OP.GG / U.GG style) -->
            <ItemsControl ItemsSource="{Binding FilteredRecentMatches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerMatchItemViewModel">
                        <Border Classes="match-card"
                                Background="{Binding ResultBgColor}"
                                CornerRadius="8"
                                Margin="0,0,0,10"
                                BorderThickness="1"
                                BorderBrush="{Binding ResultBorderColor}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="6, *">
                                <!-- Colored left accent bar -->
                                <Border Grid.Column="0" Background="{Binding AccentBarColor}" />

                                <!-- Card content -->
                                <Grid Grid.Column="1" ColumnDefinitions="130, 190, 180, 150, *" Margin="16,14">
                                    <!-- Col 0: Match Outcome & Time -->
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GameModeText}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#F0E6D2" />
                                        <TextBlock Text="{Binding ResultText}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="{Binding ResultColor}" />
                                        <TextBlock Text="{Binding FormattedDuration}"
                                                   FontSize="11"
                                                   Foreground="#8A93A5" />
                                        <TextBlock Text="{Binding FormattedTimeAgo}"
                                                   FontSize="11"
                                                   Foreground="#657182" />
                                    </StackPanel>

                                    <!-- Col 1: Champion & Level & Role -->
                                    <Grid Grid.Column="1" ColumnDefinitions="52, *" VerticalAlignment="Center">
                                        <!-- Champion Avatar with Level Badge -->
                                        <Grid Grid.Column="0" Width="48" Height="48">
                                            <Border Width="48" Height="48"
                                                    CornerRadius="24"
                                                    ClipToBounds="True"
                                                    Background="#091428"
                                                    BorderBrush="{Binding AccentBarColor}"
                                                    BorderThickness="2">
                                                <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}"
                                                       Width="48" Height="48"
                                                       Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Champ Level Badge -->
                                            <Border Background="#121824"
                                                    BorderBrush="{Binding AccentBarColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Width="18" Height="18"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding ChampLevelText}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Champion Name & Position Pill -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding ChampionName}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#F0E6D2" />
                                            <Border Background="#091428"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    BorderBrush="#252D3D"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding PositionIcon}" FontSize="11" />
                                                    <TextBlock Text="{Binding PositionName}" FontSize="10" Foreground="#8A93A5" FontWeight="Bold" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Col 2: KDA, Ratio & Kill Participation -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding KdaText}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="#FFFFFF" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Background="#091428"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    BorderBrush="#252D3D"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding KdaRatioText}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding KdaRatioColor}" />
                                            </Border>
                                            <Border Background="#091428"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    BorderBrush="#252D3D"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding KillParticipationText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding KillParticipationColor}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Col 3: CS, Gold & Damage -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding CsText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F0E6D2" />
                                        <TextBlock Text="{Binding DamageText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#E84057" />
                                        <TextBlock Text="{Binding GoldText}"
                                                   FontSize="11"
                                                   Foreground="#C8AA6E" />
                                    </StackPanel>

                                    <!-- Col 4: 10-Player Team Rosters (Blue vs Red) -->
                                    <Grid Grid.Column="4" ColumnDefinitions="*, *" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <!-- Blue Team -->
                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding BlueTeam}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MiniParticipantViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                        <Border Width="18" Height="18" CornerRadius="3" ClipToBounds="True" Background="#091428">
                                                            <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="18" Height="18" Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding NameColor}"
                                                                   FontWeight="{Binding NameWeight}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="85" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Red Team -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding RedTeam}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MiniParticipantViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                        <Border Width="18" Height="18" CornerRadius="3" ClipToBounds="True" Background="#091428">
                                                            <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="18" Height="18" Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding NameColor}"
                                                                   FontWeight="{Binding NameWeight}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="85" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. LOAD MORE MATCHES BUTTON -->
            <Button Command="{Binding LoadMoreMatchesCommand}"
                    IsEnabled="{Binding !IsLoadingMore}"
                    IsVisible="{Binding CanLoadMore}"
                    Classes="action-btn"
                    Height="42"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#121824"
                    BorderBrush="#252D3D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    Margin="0,4,0,20">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding IsLoadingMore, Converter={x:Null}, FallbackValue='ЗАВАНТАЖИТИ ЩЕ 5 МАТЧІВ'}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#0AC8B9"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
