<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GameAnalytics.Desktop.ViewModels"
             xmlns:conv="using:GameAnalytics.Desktop.Converters"
             xmlns:coreEntities="using:GameAnalytics.Core.Entities"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="850"
             x:Class="GameAnalytics.Desktop.Views.PlayerAnalyticsView"
             x:DataType="vm:PlayerAnalyticsViewModel"
             RenderOptions.BitmapInterpolationMode="HighQuality">

    <UserControl.Resources>
        <conv:BitmapAssetValueConverter x:Key="BitmapAssetConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Button Hover Animation -->
        <Style Selector="Button.action-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- Match Card Hover Animation -->
        <Style Selector="Border.match-card">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Border.match-card:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.008)" />
            <Setter Property="BorderBrush" Value="#8B5CF6" />
        </Style>

        <!-- Player Nickname Link Button -->
        <Style Selector="Button.player-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.player-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.player-link:pointerover TextBlock">
            <Setter Property="Foreground" Value="#C4B5FD" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <!-- Item Slot Hover Effect -->
        <Style Selector="Border.item-slot">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Border.item-slot:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
            <Setter Property="BorderBrush" Value="#8B5CF6" />
        </Style>

        <!-- Tactical Node Hover Effect -->
        <Style Selector="Border.tactical-node">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tactical-node:pointerover">
            <Setter Property="Background" Value="#1A1D30" />
            <Setter Property="BorderBrush" Value="#3E4466" />
        </Style>

        <!-- Expand Button Hover Effect -->
        <Style Selector="Button.expand-btn">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.0)" />
        </Style>
        <Style Selector="Button.expand-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)" />
            <Setter Property="BorderBrush" Value="#7C3AED" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18" Spacing="16" MaxWidth="1420" HorizontalAlignment="Stretch">

            <!-- 1. RIOT ID SEARCH & REGION CONSOLE -->
            <Border Background="#131522"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#22263C"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <!-- Title Bar -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="🔍 ПОШУК ГРАВЦЯ У СИСТЕМІ RIOT ID"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#C4B5FD"
                                       LetterSpacing="1.2" />
                            <TextBlock Text="Введіть ігрове ім'я, тег після # та оберіть ігровий сервер (EUW, EUNE, NA, KR тощо)"
                                       FontSize="11"
                                       Foreground="#94A3B8" />
                        </StackPanel>

                        <!-- API Status Pill -->
                        <Border Grid.Column="1"
                                Background="#1B1634"
                                BorderBrush="#7C3AED"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,5"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApiStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#A78BFA" />
                        </Border>
                    </Grid>

                    <!-- Search Input Row -->
                    <Grid ColumnDefinitions="220, *, 20, 110, Auto" RowDefinitions="Auto">
                        <!-- Server Region Dropdown -->
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableRegions}"
                                  SelectedItem="{Binding SelectedRegion}"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  FontSize="13"
                                  Margin="0,0,10,0" />

                        <!-- Game Name Input -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding GameName}"
                                 PlaceholderText="Ім'я гравця (підтримує: Qu4dyz#qu4)"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center" />

                        <!-- Hash Separator -->
                        <TextBlock Grid.Column="2"
                                   Text="#"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#A78BFA"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- Tag Line Input -->
                        <TextBox Grid.Column="3"
                                 Text="{Binding TagLine}"
                                 PlaceholderText="Тег (qu4)"
                                 Height="40"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0" />

                        <!-- Search Button -->
                        <Button Grid.Column="4"
                                Command="{Binding SearchPlayerCommand}"
                                Classes="action-btn"
                                Content="⚡ ЗНАЙТИ ГРАВЦЯ"
                                Height="40"
                                Background="#7C3AED"
                                Foreground="#FFFFFF"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="22,0"
                                CornerRadius="8"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Demo Mode Options & API Key Bar -->
                    <Border Background="#181B2B"
                            CornerRadius="8"
                            Padding="12,8"
                            BorderBrush="#252A42"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, 160, *, Auto">
                            <!-- Demo Tier Selector -->
                            <TextBlock Grid.Column="0"
                                       Text="🎮 Бажаний ранг у демо-режимі:"
                                       FontSize="12"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTiers}"
                                      SelectedItem="{Binding SelectedDemoTier}"
                                      Height="30"
                                      FontSize="12"
                                      HorizontalAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,20,0" />

                            <!-- Quick API Key Input -->
                            <TextBox Grid.Column="2"
                                     Text="{Binding ApiKeyInput}"
                                     PlaceholderText="Введіть Riot API Key (RGAPI-...) для отримання реальної статистики"
                                     Height="30"
                                     FontSize="11"
                                     PasswordChar="●"
                                     Margin="0,0,8,0" />

                            <Button Grid.Column="3"
                                    Command="{Binding SaveApiKeyCommand}"
                                    Classes="action-btn"
                                    Content="💾 Застосувати ключ"
                                    Height="30"
                                    Background="#1A1D2E"
                                    BorderBrush="#2A2F4A"
                                    BorderThickness="1"
                                    Foreground="#C4B5FD"
                                    FontSize="11"
                                    Padding="12,0"
                                    CornerRadius="6"
                                    Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#C4B5FD" />
                </StackPanel>
            </Border>

            <!-- 2. PLAYER PROFILE HEXTECH CARD (Rendered when profile is loaded) -->
            <Border Background="#131522"
                    CornerRadius="12"
                    Padding="22"
                    BorderBrush="#22263C"
                    BorderThickness="1"
                    IsVisible="{Binding Summoner, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: Profile Icon with Level Badge -->
                    <Grid Grid.Column="0" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Border Width="88" Height="88"
                                CornerRadius="44"
                                ClipToBounds="True"
                                Background="#181B2B"
                                BorderBrush="{Binding TierBadgeColor}"
                                BorderThickness="3">
                            <Image Source="{Binding ProfileIconBitmap}"
                                   Width="88" Height="88"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>

                        <!-- Level Tag floating at bottom -->
                        <Border Background="#181B2B"
                                BorderBrush="{Binding TierBadgeColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-8">
                            <TextBlock Text="{Binding Summoner.SummonerLevel, StringFormat='Рівень {0}'}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- Center: Identity & Server -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summoner.GameName}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="{Binding Summoner.TagLine, StringFormat='#{0}'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#A78BFA" />
                            <Border Background="#181B2B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" BorderBrush="#252A42" BorderThickness="1">
                                <TextBlock Text="{Binding SelectedRegion.DisplayName}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C4B5FD" />
                            </Border>
                        </StackPanel>

                        <!-- Ranked Tier & LP -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{Binding TierBadgeColor}"
                                    CornerRadius="4"
                                    Padding="10,4">
                                <TextBlock Text="{Binding Summoner.Tier, StringFormat='{}{0}'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#0B0C12" />
                            </Border>

                            <TextBlock Text="{Binding Summoner.Rank}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="{Binding Summoner.LeaguePoints, StringFormat='{}{0} LP'}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#A78BFA"
                                       VerticalAlignment="Center" />

                            <Border Background="#181B2B" CornerRadius="4" Padding="6,2" BorderBrush="#252A42" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Ranked Solo/Duo 5v5"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Promo / Next Tier Progress -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,3,0,0" IsVisible="{Binding HasRankProgress}">
                            <ProgressBar Value="{Binding NextTierProgressValue}"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="5"
                                         Width="120"
                                         CornerRadius="2.5"
                                         Foreground="#8B5CF6"
                                         Background="#1A1D2E"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NextTierProgressText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Top Champion Masteries -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" IsVisible="{Binding Summoner.TopMasteries.Count}">
                            <TextBlock Text="МАЙСТЕРНІСТЬ:" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Summoner.TopMasteries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="coreEntities:ChampionMasteryInfo">
                                        <Border Background="#181B2B" BorderBrush="#252A42" BorderThickness="1" CornerRadius="4" Padding="5,2"
                                                ToolTip.Tip="{Binding FormattedPoints, StringFormat='{}{0} очок майстерності'}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Width="16" Height="16" CornerRadius="8" ClipToBounds="True">
                                                    <Image Source="{Binding ChampionIconUrl, Converter={StaticResource BitmapAssetConverter}}" Width="16" Height="16" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                                <TextBlock Text="{Binding ChampionName}" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                <Border Background="#7C3AED" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ChampionLevel, StringFormat='M{0}'}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: WinRate & Record Badge -->
                    <Border Grid.Column="2"
                            Background="#181B2B"
                            CornerRadius="10"
                            Padding="18,14"
                            BorderBrush="#252A42"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Summoner.WinRate, StringFormat='Вінрейт: {0}%'}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#A78BFA"
                                       HorizontalAlignment="Right" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Summoner.Wins, StringFormat='{}{0}W'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#818CF8" />
                                <TextBlock Text="{Binding Summoner.Losses, StringFormat='{}{0}L'}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#F43F5E" />
                                <TextBlock Text="{Binding Summoner.TotalGames, StringFormat='({0} матчів)'}"
                                           FontSize="12"
                                           Foreground="#94A3B8" />
                            </StackPanel>

                            <!-- Win/Loss Ratio Progress Bar -->
                            <ProgressBar Value="{Binding Summoner.Wins}"
                                         Minimum="0"
                                         Maximum="{Binding Summoner.TotalGames}"
                                         Height="6"
                                         Width="150"
                                         CornerRadius="3"
                                         Foreground="#818CF8"
                                         Background="#F43F5E"
                                         Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.5 RECENT GAMES SESSION OVERVIEW -->
            <Border Background="#121824"
                    CornerRadius="10"
                    Padding="18"
                    BorderBrush="#1E283A"
                    BorderThickness="1"
                    IsVisible="{Binding HasSessionData}">
                <Grid ColumnDefinitions="200, 200, *, 170">
                    <!-- Col 0: WinRate & Record -->
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="СТАТИСТИКА СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <TextBlock Text="{Binding SessionRecordText}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#F0E6D2" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SessionWinRate, StringFormat='{}{0:F1}% WR'}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#0AC8B9" />
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SessionNetLpText}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{Binding SessionNetLpColor}" />
                            </Border>
                        </StackPanel>
                        <!-- Mini Win/Loss Bar -->
                        <ProgressBar Value="{Binding SessionWins}"
                                     Minimum="0"
                                     Maximum="{Binding SessionTotalGames}"
                                     Height="5"
                                     Width="160"
                                     Foreground="#5383E8"
                                     Background="#E84057"
                                     Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Col 1: Average KDA & Kill Participation -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="СЕРЕДНІЙ KDA СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <TextBlock Text="{Binding AvgKdaNumbers}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding SessionKdaRatioText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding SessionKdaRatioColor}" />
                            </Border>
                            <Border Background="#091428"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    BorderBrush="#252D3D"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding AvgKpText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#C8AA6E" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Col 2: Top 3 Most Played Champions -->
                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="НАЙЧАСТІШІ ЧЕМПІОНИ СЕСІЇ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1" />
                        <ItemsControl ItemsSource="{Binding TopRecentChampions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentChampionStatViewModel">
                                    <Grid ColumnDefinitions="32, *" VerticalAlignment="Center">
                                        <!-- Champion Avatar -->
                                        <Border Grid.Column="0"
                                                Width="30" Height="30"
                                                CornerRadius="15"
                                                ClipToBounds="True"
                                                Background="#091428"
                                                BorderBrush="#252D3D"
                                                BorderThickness="1.5">
                                            <Image Source="{Binding ChampionIcon}"
                                                   Width="30" Height="30"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <!-- Champion Details -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                            <TextBlock Text="{Binding ChampionName}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#F0E6D2" />
                                            <TextBlock Text="{Binding WinRateText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding WinRateColor}" />
                                            <TextBlock Text="{Binding KdaText}"
                                                       FontSize="10"
                                                       Foreground="#8A93A5" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Col 3: Preferred Role -->
                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="ПРІОРИТЕТНА ЛІНІЯ"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8A93A5"
                                   LetterSpacing="1.1"
                                   HorizontalAlignment="Right" />
                        <Border Background="#091428"
                                CornerRadius="6"
                                Padding="12,6"
                                BorderBrush="#252D3D"
                                BorderThickness="1"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PreferredRoleText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#F0E6D2" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2.6 AI PLAYER MOMENTUM & TILT DETECTOR (ML Feature) -->
            <Border Background="#101726"
                    CornerRadius="10"
                    Padding="20,16"
                    BorderBrush="#1F2D44"
                    BorderThickness="1"
                    IsVisible="{Binding HasMomentumData}">
                <Grid ColumnDefinitions="340, 1, *">
                    <!-- Left: Gauge & Score -->
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Margin="0,0,18,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🤖 ШІ-ОЦІНКА ФОРМИ (MOMENTUM)"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#C8AA6E"
                                       LetterSpacing="1.1" />
                            <Border Background="#091428" CornerRadius="4" Padding="6,2" BorderBrush="#0AC8B9" BorderThickness="1">
                                <TextBlock Text="ML.NET" FontSize="10" Foreground="#0AC8B9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto, *">
                            <!-- Momentum Score Number -->
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{Binding MomentumScoreText}"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{Binding MomentumStatusColor}" />
                                <TextBlock Text="{Binding MomentumStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding MomentumStatusColor}" />
                            </StackPanel>

                            <!-- Mini Metrics Stack -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                <Border Background="#141E2F" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding MomentumStreakText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#F0E6D2" />
                                </Border>
                                <Border Background="#141E2F" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding NextGameWinChanceText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0AC8B9" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Momentum Progress Bar -->
                        <ProgressBar Value="{Binding MomentumScore}"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     CornerRadius="4"
                                     Foreground="{Binding MomentumStatusColor}"
                                     Background="#1F2633" />
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Width="1" Fill="#1F2D44" Margin="0,2,18,2" />

                    <!-- Right: AI Recommendation Box -->
                    <Grid Grid.Column="2" ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="💡" FontSize="26" VerticalAlignment="Top" Margin="0,2,14,0" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="АНАЛІТИЧНА РЕКОМЕНДАЦІЯ ШІ:"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8A93A5"
                                       LetterSpacing="1.0" />
                            <TextBlock Text="{Binding AiAdviceText}"
                                       FontSize="13"
                                       Foreground="#F0E6D2"
                                       TextWrapping="Wrap"
                                       LineHeight="20" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2.7 GLOBAL COACHING & ROLE MASTERY DASHBOARD -->
            <Border Background="#131522"
                    CornerRadius="12"
                    Padding="20,18"
                    BorderBrush="#22263C"
                    BorderThickness="1"
                    IsVisible="{Binding HasCoachingData}">
                <StackPanel Spacing="14">
                    <!-- Header with Role & Overall Score -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="👑 ТАКТИЧНИЙ КОУЧИНГ ТА АНАЛІТИКА РОЛІ"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#C4B5FD"
                                       LetterSpacing="1.2"
                                       VerticalAlignment="Center" />
                            <Border Background="#181B2B" CornerRadius="6" Padding="8,3" BorderBrush="#7C3AED" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="АНАЛІТИКА ЛІНІЇ:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CoachingReport.RoleName}" FontSize="10" Foreground="#A78BFA" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CoachingReport.RoleIcon}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Background="#181B2B" CornerRadius="6" Padding="8,3" BorderBrush="#252A42" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CoachingReport.TotalMatchesAnalyzed, StringFormat='Матчів: {0}'}" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Overall Grade Badge -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="ЗАГАЛЬНА ОЦІНКА МАЙСТЕРНОСТІ:"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                            <Border Background="{Binding CoachingReport.OverallGradeColor}"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CoachingReport.OverallGrade}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0B0C12" />
                            </Border>
                            <TextBlock Text="{Binding CoachingReport.OverallScore, StringFormat='{}{0} / 100'}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- 4 Skill Pillar Cards (Combat, Economy, Objectives, Survival) -->
                    <Grid ColumnDefinitions="*, *, *, *" Margin="0,4">
                        <!-- Pillar 1: Combat -->
                        <Border Grid.Column="0"
                                Background="#161928"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="0,0,4,0"
                                BorderBrush="#24283E"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding CoachingReport.Combat.Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoachingReport.Combat.PillarName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="{Binding CoachingReport.Combat.GradeColor}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoachingReport.Combat.Grade}" FontSize="10" FontWeight="Bold" Foreground="#0B0C12" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding CoachingReport.Combat.PlayerValueText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding CoachingReport.Combat.BenchmarkText}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border Background="#1B1E32" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding CoachingReport.Combat.DiffText}" FontSize="9" FontWeight="Bold" Foreground="{Binding CoachingReport.Combat.DiffColor}" />
                                    </Border>
                                </StackPanel>
                                <ProgressBar Value="{Binding CoachingReport.Combat.Score}" Minimum="0" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{Binding CoachingReport.Combat.GradeColor}" Background="#1E2235" />
                                <TextBlock Text="{Binding CoachingReport.Combat.Description}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                        </Border>

                        <!-- Pillar 2: Economy / Farm -->
                        <Border Grid.Column="1"
                                Background="#161928"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="2,0,2,0"
                                BorderBrush="#24283E"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding CoachingReport.Economy.Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoachingReport.Economy.PillarName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="{Binding CoachingReport.Economy.GradeColor}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoachingReport.Economy.Grade}" FontSize="10" FontWeight="Bold" Foreground="#0B0C12" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding CoachingReport.Economy.PlayerValueText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding CoachingReport.Economy.BenchmarkText}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border Background="#1B1E32" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding CoachingReport.Economy.DiffText}" FontSize="9" FontWeight="Bold" Foreground="{Binding CoachingReport.Economy.DiffColor}" />
                                    </Border>
                                </StackPanel>
                                <ProgressBar Value="{Binding CoachingReport.Economy.Score}" Minimum="0" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{Binding CoachingReport.Economy.GradeColor}" Background="#1E2235" />
                                <TextBlock Text="{Binding CoachingReport.Economy.Description}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                        </Border>

                        <!-- Pillar 3: Map & Objectives -->
                        <Border Grid.Column="2"
                                Background="#161928"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="2,0,2,0"
                                BorderBrush="#24283E"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding CoachingReport.Objectives.Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoachingReport.Objectives.PillarName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="{Binding CoachingReport.Objectives.GradeColor}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoachingReport.Objectives.Grade}" FontSize="10" FontWeight="Bold" Foreground="#0B0C12" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding CoachingReport.Objectives.PlayerValueText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding CoachingReport.Objectives.BenchmarkText}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border Background="#1B1E32" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding CoachingReport.Objectives.DiffText}" FontSize="9" FontWeight="Bold" Foreground="{Binding CoachingReport.Objectives.DiffColor}" />
                                    </Border>
                                </StackPanel>
                                <ProgressBar Value="{Binding CoachingReport.Objectives.Score}" Minimum="0" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{Binding CoachingReport.Objectives.GradeColor}" Background="#1E2235" />
                                <TextBlock Text="{Binding CoachingReport.Objectives.Description}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                        </Border>

                        <!-- Pillar 4: Survival -->
                        <Border Grid.Column="3"
                                Background="#161928"
                                CornerRadius="10"
                                Padding="14,12"
                                Margin="4,0,0,0"
                                BorderBrush="#24283E"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding CoachingReport.Survival.Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoachingReport.Survival.PillarName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Background="{Binding CoachingReport.Survival.GradeColor}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoachingReport.Survival.Grade}" FontSize="10" FontWeight="Bold" Foreground="#0B0C12" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding CoachingReport.Survival.PlayerValueText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding CoachingReport.Survival.BenchmarkText}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Border Background="#1B1E32" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding CoachingReport.Survival.DiffText}" FontSize="9" FontWeight="Bold" Foreground="{Binding CoachingReport.Survival.DiffColor}" />
                                    </Border>
                                </StackPanel>
                                <ProgressBar Value="{Binding CoachingReport.Survival.Score}" Minimum="0" Maximum="100" Height="5" CornerRadius="2.5" Foreground="{Binding CoachingReport.Survival.GradeColor}" Background="#1E2235" />
                                <TextBlock Text="{Binding CoachingReport.Survival.Description}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Coaching Advice Box -->
                    <Border Background="#1B1634"
                            CornerRadius="8"
                            Padding="14,10"
                            BorderBrush="#7C3AED"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="🎓" FontSize="24" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="РЕКОМЕНДАЦІЇ ТРЕНЕРА:"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#C4B5FD"
                                           LetterSpacing="1.0" />
                                <TextBlock Text="{Binding CoachingReport.CoachAdvice}"
                                           FontSize="12"
                                           Foreground="#E2E8F0"
                                           TextWrapping="Wrap"
                                           LineHeight="18" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. RECENT MATCHES SECTION HEADER & QUEUE FILTER -->
            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4,0,0">
                <TextBlock Grid.Column="0"
                           Text="ІСТОРІЯ ОСТАННІХ МАТЧІВ"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#C4B5FD"
                           LetterSpacing="1.2"
                           VerticalAlignment="Center" />

                <!-- Queue Filter ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableQueueFilters}"
                          SelectedItem="{Binding SelectedQueueFilter}"
                          Height="32"
                          Width="150"
                          FontSize="11"
                          VerticalContentAlignment="Center"
                          Margin="0,0,12,0" />

                <!-- Match Count Pill -->
                <Border Grid.Column="2"
                        Background="#161928"
                        CornerRadius="6"
                        Padding="12,5"
                        BorderBrush="#252A42"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredRecentMatches.Count, StringFormat='Показано матчів: {0}'}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#C4B5FD" />
                </Border>
            </Grid>

            <!-- 4. MODERN MATCH CARDS LIST (with Accordion) -->
            <ItemsControl ItemsSource="{Binding FilteredRecentMatches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayerMatchItemViewModel">
                        <Border Classes="match-card"
                                Background="{Binding ResultBgColor}"
                                CornerRadius="8"
                                Margin="0,0,0,10"
                                BorderThickness="1"
                                BorderBrush="{Binding ResultBorderColor}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="4, *">
                                <!-- Colored left accent bar -->
                                <Border Grid.Column="0" Background="{Binding AccentBarColor}" />

                                <!-- Card Vertical Content (Compact Row + Accordion Details) -->
                                <StackPanel Grid.Column="1">
                                     <!-- Top Main Row with Dedicated Non-Overlapping Columns -->
                                     <Grid ColumnDefinitions="115, 205, 130, 125, 110, *, 80" Margin="14,10">
                                         <!-- Col 0: Match Outcome & Time & LP Delta -->
                                         <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" ClipToBounds="True">
                                             <TextBlock Text="{Binding GameModeText}"
                                                        FontWeight="Bold"
                                                        FontSize="11"
                                                        Foreground="#94A3B8"
                                                        TextTrimming="CharacterEllipsis" />
                                             <TextBlock Text="{Binding FormattedTimeAgo}"
                                                        FontSize="10"
                                                        Foreground="#64748B" />
                                             <!-- LP Delta (Prominent bold indicator like reference) -->
                                             <Border Background="{Binding LpChangeBg}"
                                                     CornerRadius="4"
                                                     Padding="6,2"
                                                     HorizontalAlignment="Left"
                                                     Margin="0,2,0,2"
                                                     IsVisible="{Binding HasLpChange}">
                                                 <TextBlock Text="{Binding LpChangeText}"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding LpChangeFg}" />
                                             </Border>
                                             <StackPanel Orientation="Horizontal" Spacing="5">
                                                 <TextBlock Text="{Binding ResultText}"
                                                            FontWeight="Bold"
                                                            FontSize="12"
                                                            Foreground="{Binding ResultColor}" />
                                                 <TextBlock Text="{Binding FormattedDuration}"
                                                            FontSize="11"
                                                            Foreground="#94A3B8"
                                                            VerticalAlignment="Center" />
                                             </StackPanel>
                                         </StackPanel>

                                        <!-- Col 1: Champion & Level & Spells & Runes & Role (Spacious 205px) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ClipToBounds="True">
                                            <!-- Champion Avatar with Level Badge (Square rounded like reference) -->
                                            <Grid Width="46" Height="46">
                                                <Border Width="46" Height="46"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Background="#161928"
                                                        BorderBrush="{Binding AccentBarColor}"
                                                        BorderThickness="1.5">
                                                    <Image Source="{Binding ChampionIcon}"
                                                           Width="46" Height="46"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>

                                                <!-- Champ Level Badge -->
                                                <Border Background="#161928"
                                                        BorderBrush="#252A42"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="4,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,-2,-2">
                                                    <TextBlock Text="{Binding ChampLevelText}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Summoner Spells & Runes 2x2 Mini Grid -->
                                            <Grid ColumnDefinitions="21, 21" RowDefinitions="21, 21" Width="44" Height="44">
                                                <!-- Spell 1 (top-left) -->
                                                <Border Grid.Row="0" Grid.Column="0" Width="21" Height="21" CornerRadius="4" Background="#121422" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding Summoner1Tooltip}">
                                                    <Image Source="{Binding Summoner1Icon}" Width="21" Height="21" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                                <!-- Spell 2 (bottom-left) -->
                                                <Border Grid.Row="1" Grid.Column="0" Width="21" Height="21" CornerRadius="4" Background="#121422" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True" Margin="0,2,0,0"
                                                        ToolTip.Tip="{Binding Summoner2Tooltip}">
                                                    <Image Source="{Binding Summoner2Icon}" Width="21" Height="21" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                                <!-- Keystone Rune (top-right) -->
                                                <Border Grid.Row="0" Grid.Column="1" Width="21" Height="21" CornerRadius="10.5" Background="#121422" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True" Margin="2,0,0,0"
                                                        ToolTip.Tip="Головна руна (Кістоун)">
                                                    <Image Source="{Binding PrimaryRuneIcon}" Width="17" Height="17" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                                <!-- Secondary Style Rune (bottom-right) -->
                                                <Border Grid.Row="1" Grid.Column="1" Width="21" Height="21" CornerRadius="10.5" Background="#121422" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True" Margin="2,2,0,0"
                                                        ToolTip.Tip="Вторинна гілка рун">
                                                    <Image Source="{Binding SecondaryRuneIcon}" Width="15" Height="15" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                </Border>
                                            </Grid>

                                            <!-- Champion Name & Position Pill (Never overlaps Col 2) -->
                                            <StackPanel VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                                                <TextBlock Text="{Binding ChampionName}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           Foreground="#F8FAFC"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="92" />
                                                <Border Background="#181B2B"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        HorizontalAlignment="Left"
                                                        BorderBrush="#252A42"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <TextBlock Text="{Binding PositionIcon}" FontSize="9" />
                                                        <TextBlock Text="{Binding PositionName}" FontSize="8" Foreground="#A5B4FC" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 2: KDA, Ratio & CS (130px with safe margin) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="6,0,0,0" ClipToBounds="True">
                                            <TextBlock Text="{Binding KdaText}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="#FFFFFF" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding KdaRatioText}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding KdaRatioColor}" />
                                                <TextBlock Text="•" FontSize="10" Foreground="#4A5468" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CsText}"
                                                           FontSize="10"
                                                           Foreground="#CBD5E1" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0">
                                                <Border Background="#1B1634"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        BorderBrush="#7C3AED"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding KillParticipationText}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding KillParticipationColor}" />
                                                </Border>
                                                <!-- MultiKill Badge -->
                                                <Border Background="{Binding MultiKillBg}"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        IsVisible="{Binding HasMultiKill}">
                                                    <TextBlock Text="{Binding MultiKillText}"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Foreground="#FFFFFF" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 3: Items Grid (2 rows x 3 items + Trinket, 125px) -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Center">
                                            <!-- Top row: 3 items + trinket -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding ItemSlot0.ToolTipText}">
                                                    <Image Source="{Binding ItemSlot0.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding ItemSlot0.HasItem}" />
                                                </Border>
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding ItemSlot1.ToolTipText}">
                                                    <Image Source="{Binding ItemSlot1.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding ItemSlot1.HasItem}" />
                                                </Border>
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding ItemSlot2.ToolTipText}">
                                                    <Image Source="{Binding ItemSlot2.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding ItemSlot2.HasItem}" />
                                                </Border>
                                                <!-- Trinket -->
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#7C3AED" BorderThickness="1" ClipToBounds="True" Margin="2,0,0,0"
                                                        ToolTip.Tip="{Binding PlayerTrinket.ToolTipText}">
                                                    <Image Source="{Binding PlayerTrinket.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding PlayerTrinket.HasItem}" />
                                                </Border>
                                            </StackPanel>
                                            <!-- Bottom row: 3 items -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding ItemSlot3.ToolTipText}">
                                                    <Image Source="{Binding ItemSlot3.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding ItemSlot3.HasItem}" />
                                                </Border>
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding ItemSlot4.ToolTipText}">
                                                    <Image Source="{Binding ItemSlot4.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding ItemSlot4.HasItem}" />
                                                </Border>
                                                <Border Classes="item-slot" Width="27" Height="27" CornerRadius="4" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                        ToolTip.Tip="{Binding ItemSlot5.ToolTipText}">
                                                    <Image Source="{Binding ItemSlot5.ItemIcon}" Width="27" Height="27" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding ItemSlot5.HasItem}" />
                                                </Border>
                                                <!-- Align space for trinket -->
                                                <Border Width="27" Height="27" Margin="2,0,0,0" Background="Transparent" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Col 4: Performance & Coach Tag (110px) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <!-- Grade Badge -->
                                                <Border Background="{Binding MatchGradeBg}"
                                                        CornerRadius="4"
                                                        Padding="5,1">
                                                    <TextBlock Text="{Binding MatchGrade}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="#0B0C12" />
                                                </Border>
                                                <!-- MVP / ACE Badge -->
                                                <Border Background="{Binding PerformanceBadgeBg}"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        IsVisible="{Binding HasPerformanceBadge}">
                                                    <TextBlock Text="{Binding PerformanceBadgeText}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding PerformanceBadgeFg}" />
                                                </Border>
                                            </StackPanel>
                                            <!-- Coaching Badge (e.g. Hard Carry, CS Monster, etc.) -->
                                            <Border Background="#1B1634"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    BorderBrush="#7C3AED"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding HasCoachingBadge}">
                                                <TextBlock Text="{Binding CoachingBadgeText}"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="#C4B5FD" />
                                            </Border>
                                            <TextBlock Text="{Binding DamageText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FB7185" />
                                            <TextBlock Text="{Binding VisionScoreText}"
                                                       FontSize="9"
                                                       Foreground="#94A3B8" />
                                        </StackPanel>

                                        <!-- Col 5: 10-Player Team Rosters (Blue vs Red) -->
                                        <Grid Grid.Column="5" ColumnDefinitions="*, *" VerticalAlignment="Center" Margin="8,0,4,0">
                                            <!-- Blue Team -->
                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding BlueTeam}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MiniParticipantViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                                            <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True" Background="#161928">
                                                                <Image Source="{Binding ChampionIcon}" Width="16" Height="16" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="10"
                                                                       Foreground="{Binding NameColor}"
                                                                       FontWeight="{Binding NameWeight}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="88"
                                                                       IsVisible="{Binding IsCurrentPlayer}"
                                                                       ToolTip.Tip="{Binding ToolTipText}" />
                                                            <Button Classes="player-link"
                                                                    Command="{Binding SelectPlayerCommand}"
                                                                    CommandParameter="{Binding FullRiotId}"
                                                                    IsVisible="{Binding !IsCurrentPlayer}"
                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="10"
                                                                           Foreground="{Binding NameColor}"
                                                                           FontWeight="{Binding NameWeight}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="88" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Red Team -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding RedTeam}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:MiniParticipantViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                                            <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True" Background="#161928">
                                                                <Image Source="{Binding ChampionIcon}" Width="16" Height="16" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="10"
                                                                       Foreground="{Binding NameColor}"
                                                                       FontWeight="{Binding NameWeight}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="88"
                                                                       IsVisible="{Binding IsCurrentPlayer}"
                                                                       ToolTip.Tip="{Binding ToolTipText}" />
                                                            <Button Classes="player-link"
                                                                    Command="{Binding SelectPlayerCommand}"
                                                                    CommandParameter="{Binding FullRiotId}"
                                                                    IsVisible="{Binding !IsCurrentPlayer}"
                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="10"
                                                                           Foreground="{Binding NameColor}"
                                                                           FontWeight="{Binding NameWeight}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="88" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <!-- Col 6: Accordion Expand Button -->
                                        <Button Grid.Column="6"
                                                Classes="expand-btn"
                                                Content="{Binding ExpandButtonText}"
                                                Command="{Binding ToggleExpandCommand}"
                                                Foreground="{Binding ExpandButtonColor}"
                                                Background="#181B2B"
                                                BorderBrush="#252A42"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Padding="8,5"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- Expanded 5v5 Match Details Accordion Panel -->
                                    <Border IsVisible="{Binding IsExpanded}"
                                            Background="#0E101B"
                                            BorderBrush="{Binding ResultBorderColor}"
                                            BorderThickness="0,1,0,0"
                                            Padding="14,10">
                                        <StackPanel Spacing="10">
                                            <!-- TAB NAVIGATION (Scoreboard vs Tactical Breakdown) -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                                <Button Command="{Binding ShowScoreboardTabCommand}"
                                                        Background="{Binding ScoreboardTabBg}"
                                                        Foreground="{Binding ScoreboardTabFg}"
                                                        BorderBrush="#252A42"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="14,6"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Cursor="Hand">
                                                    👥 Склад команд 5v5
                                                </Button>
                                                <Button Command="{Binding ShowTacticalTabCommand}"
                                                        Background="{Binding TacticalTabBg}"
                                                        Foreground="{Binding TacticalTabFg}"
                                                        BorderBrush="#252A42"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="14,6"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Cursor="Hand">
                                                    ⏱️ Похвилинний тактичний розбір гри
                                                </Button>
                                            </StackPanel>

                                            <!-- TAB 1: 5V5 TEAMS SCOREBOARD -->
                                            <StackPanel Spacing="10" IsVisible="{Binding IsScoreboardTabActive}">
                                                <!-- BLUE TEAM TABLE -->
                                                <Border Background="#121524" CornerRadius="8" BorderBrush="#22263C" BorderThickness="1" Padding="10">
                                                    <StackPanel Spacing="4">
                                                        <!-- Team Header -->
                                                        <Grid ColumnDefinitions="280, 95, 150, 115, *" Margin="4,2">
                                                            <TextBlock Grid.Column="0" Text="🔷 СИНЯ КОМАНДА" FontWeight="Bold" FontSize="12" Foreground="#818CF8" />
                                                            <TextBlock Grid.Column="1" Text="KDA" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                            <TextBlock Grid.Column="2" Text="ШКОДА ЧЕМПІОНАМ" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                            <TextBlock Grid.Column="3" Text="ФАРМ / ЗОЛОТО" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                            <TextBlock Grid.Column="4" Text="ПРЕДМЕТИ (6 + ВАРД)" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding BlueTeamDetailed}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DetailedParticipantViewModel">
                                                                    <Border Background="#16192A" CornerRadius="6" Padding="6,4" Margin="0,1" BorderBrush="#202438" BorderThickness="1">
                                                                        <Grid ColumnDefinitions="280, 95, 150, 115, *">
                                                                             <!-- Player Info with Clickable Link -->
                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ClipToBounds="True">
                                                                                <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True" Background="#121422" BorderBrush="#252A42" BorderThickness="1">
                                                                                    <Image Source="{Binding ChampionIcon}" Width="28" Height="28" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                </Border>
                                                                                <!-- Mini Spells & Rune -->
                                                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                                    <StackPanel Spacing="1">
                                                                                        <Border Width="13" Height="13" CornerRadius="2" ClipToBounds="True" ToolTip.Tip="{Binding Summoner1Tooltip}">
                                                                                            <Image Source="{Binding Summoner1Icon}" Width="13" Height="13" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                        </Border>
                                                                                        <Border Width="13" Height="13" CornerRadius="2" ClipToBounds="True" ToolTip.Tip="{Binding Summoner2Tooltip}">
                                                                                            <Image Source="{Binding Summoner2Icon}" Width="13" Height="13" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <Border Width="15" Height="15" CornerRadius="7.5" Background="#121422" ClipToBounds="True" VerticalAlignment="Center">
                                                                                        <Image Source="{Binding PrimaryRuneIcon}" Width="15" Height="15" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <!-- Match Grade Pill -->
                                                                                <Border Background="{Binding MatchGradeColor}"
                                                                                        CornerRadius="3"
                                                                                        Padding="4,1"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding MatchGrade}"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#0B0C12" />
                                                                                </Border>
                                                                                <Border Background="{Binding BadgeBg}"
                                                                                        CornerRadius="3"
                                                                                        Padding="4,1"
                                                                                        VerticalAlignment="Center"
                                                                                        IsVisible="{Binding HasBadge}">
                                                                                    <TextBlock Text="{Binding BadgeText}"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#FFFFFF" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding PositionIcon}" FontSize="12" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="12"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{Binding NameColor}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="115"
                                                                                           IsVisible="{Binding IsCurrentPlayer}"
                                                                                           ToolTip.Tip="{Binding ToolTipText}" />
                                                                                <Button Classes="player-link"
                                                                                        Command="{Binding SelectPlayerCommand}"
                                                                                        CommandParameter="{Binding FullRiotId}"
                                                                                        IsVisible="{Binding !IsCurrentPlayer}"
                                                                                        ToolTip.Tip="{Binding ToolTipText}">
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               FontSize="12"
                                                                                               FontWeight="{Binding NameWeight}"
                                                                                               Foreground="{Binding NameColor}"
                                                                                               VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="115" />
                                                                                </Button>
                                                                                <TextBlock Text="{Binding ChampLevelText, StringFormat='lvl {0}'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                                                            </StackPanel>

                                                                            <!-- KDA -->
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                <TextBlock Text="{Binding KdaText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                                <TextBlock Text="{Binding KdaRatioText}" FontSize="10" Foreground="#94A3B8" />
                                                                            </StackPanel>

                                                                            <!-- Damage bar (strictly bounded) -->
                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                                                                                <TextBlock Text="{Binding DamageText}" FontSize="11" FontWeight="Bold" Foreground="#FB7185" />
                                                                                <ProgressBar Value="{Binding DamagePercentOfMax}"
                                                                                             Minimum="0"
                                                                                             Maximum="100"
                                                                                             MinWidth="0"
                                                                                             Width="120"
                                                                                             MaxWidth="120"
                                                                                             Height="6"
                                                                                             ClipToBounds="True"
                                                                                             CornerRadius="3"
                                                                                             Foreground="#FB7185"
                                                                                             Background="#1E2235"
                                                                                             HorizontalAlignment="Left" />
                                                                            </StackPanel>

                                                                            <!-- Farm, Gold & Vision -->
                                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                                                                <TextBlock Text="{Binding CsText, StringFormat='{}{0} CS'}" FontSize="11" Foreground="#F8FAFC" />
                                                                                <TextBlock Text="{Binding GoldText}" FontSize="11" Foreground="#C4B5FD" />
                                                                                <TextBlock Text="{Binding VisionText, StringFormat='W: {0}'}" FontSize="9" Foreground="#94A3B8" />
                                                                            </StackPanel>

                                                                            <!-- Items with Tooltips -->
                                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:ItemSlotViewModel">
                                                                                            <Border Width="24" Height="24" CornerRadius="3" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                                                <Image Source="{Binding ItemIcon}" Width="24" Height="24" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding HasItem}" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <!-- Trinket with Tooltip -->
                                                                                <Border Width="24" Height="24" CornerRadius="3" Background="#0E101A" BorderBrush="#7C3AED" BorderThickness="1" ClipToBounds="True" Margin="3,0,0,0"
                                                                                        ToolTip.Tip="{Binding Trinket.ToolTipText}">
                                                                                    <Image Source="{Binding Trinket.ItemIcon}" Width="24" Height="24" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding Trinket.HasItem}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- RED TEAM TABLE -->
                                                <Border Background="#1E121A" CornerRadius="8" BorderBrush="#3E1C2B" BorderThickness="1" Padding="10">
                                                    <StackPanel Spacing="4">
                                                        <!-- Team Header -->
                                                        <Grid ColumnDefinitions="280, 95, 150, 115, *" Margin="4,2">
                                                            <TextBlock Grid.Column="0" Text="🔴 ЧЕРВОНА КОМАНДА" FontWeight="Bold" FontSize="12" Foreground="#FB7185" />
                                                            <TextBlock Grid.Column="1" Text="KDA" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                            <TextBlock Grid.Column="2" Text="ШКОДА ЧЕМПІОНАМ" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                            <TextBlock Grid.Column="3" Text="ФАРМ / ЗОЛОТО" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                            <TextBlock Grid.Column="4" Text="ПРЕДМЕТИ (6 + ВАРД)" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" />
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{Binding RedTeamDetailed}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DetailedParticipantViewModel">
                                                                    <Border Background="#24141E" CornerRadius="6" Padding="6,4" Margin="0,1" BorderBrush="#3E1C2B" BorderThickness="1">
                                                                        <Grid ColumnDefinitions="280, 95, 150, 115, *">
                                                                             <!-- Player Info with Clickable Link -->
                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ClipToBounds="True">
                                                                                <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True" Background="#160E13" BorderBrush="#3E1C2B" BorderThickness="1">
                                                                                    <Image Source="{Binding ChampionIcon}" Width="28" Height="28" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                </Border>
                                                                                <!-- Mini Spells & Rune -->
                                                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                                    <StackPanel Spacing="1">
                                                                                        <Border Width="13" Height="13" CornerRadius="2" ClipToBounds="True" ToolTip.Tip="{Binding Summoner1Tooltip}">
                                                                                            <Image Source="{Binding Summoner1Icon}" Width="13" Height="13" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                        </Border>
                                                                                        <Border Width="13" Height="13" CornerRadius="2" ClipToBounds="True" ToolTip.Tip="{Binding Summoner2Tooltip}">
                                                                                            <Image Source="{Binding Summoner2Icon}" Width="13" Height="13" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <Border Width="15" Height="15" CornerRadius="7.5" Background="#160E13" ClipToBounds="True" VerticalAlignment="Center">
                                                                                        <Image Source="{Binding PrimaryRuneIcon}" Width="15" Height="15" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <!-- Match Grade Pill -->
                                                                                <Border Background="{Binding MatchGradeColor}"
                                                                                        CornerRadius="3"
                                                                                        Padding="4,1"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding MatchGrade}"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#0B0C12" />
                                                                                </Border>
                                                                                <Border Background="{Binding BadgeBg}"
                                                                                        CornerRadius="3"
                                                                                        Padding="4,1"
                                                                                        VerticalAlignment="Center"
                                                                                        IsVisible="{Binding HasBadge}">
                                                                                    <TextBlock Text="{Binding BadgeText}"
                                                                                               FontSize="9"
                                                                                               FontWeight="Bold"
                                                                                               Foreground="#FFFFFF" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding PositionIcon}" FontSize="12" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="12"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{Binding NameColor}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="115"
                                                                                           IsVisible="{Binding IsCurrentPlayer}"
                                                                                           ToolTip.Tip="{Binding ToolTipText}" />
                                                                                <Button Classes="player-link"
                                                                                        Command="{Binding SelectPlayerCommand}"
                                                                                        CommandParameter="{Binding FullRiotId}"
                                                                                        IsVisible="{Binding !IsCurrentPlayer}"
                                                                                        ToolTip.Tip="{Binding ToolTipText}">
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               FontSize="12"
                                                                                               FontWeight="{Binding NameWeight}"
                                                                                               Foreground="{Binding NameColor}"
                                                                                               VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="115" />
                                                                                </Button>
                                                                                <TextBlock Text="{Binding ChampLevelText, StringFormat='lvl {0}'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                                                            </StackPanel>

                                                                            <!-- KDA -->
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                <TextBlock Text="{Binding KdaText}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                                <TextBlock Text="{Binding KdaRatioText}" FontSize="10" Foreground="#94A3B8" />
                                                                            </StackPanel>

                                                                            <!-- Damage bar (strictly bounded) -->
                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                                                                                <TextBlock Text="{Binding DamageText}" FontSize="11" FontWeight="Bold" Foreground="#FB7185" />
                                                                                <ProgressBar Value="{Binding DamagePercentOfMax}"
                                                                                             Minimum="0"
                                                                                             Maximum="100"
                                                                                             MinWidth="0"
                                                                                             Width="120"
                                                                                             MaxWidth="120"
                                                                                             Height="6"
                                                                                             ClipToBounds="True"
                                                                                             CornerRadius="3"
                                                                                             Foreground="#FB7185"
                                                                                             Background="#1E2235"
                                                                                             HorizontalAlignment="Left" />
                                                                            </StackPanel>

                                                                            <!-- Farm, Gold & Vision -->
                                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                                                                <TextBlock Text="{Binding CsText, StringFormat='{}{0} CS'}" FontSize="11" Foreground="#F8FAFC" />
                                                                                <TextBlock Text="{Binding GoldText}" FontSize="11" Foreground="#C4B5FD" />
                                                                                <TextBlock Text="{Binding VisionText, StringFormat='W: {0}'}" FontSize="9" Foreground="#94A3B8" />
                                                                            </StackPanel>

                                                                            <!-- Items with Tooltips -->
                                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:ItemSlotViewModel">
                                                                                            <Border Width="24" Height="24" CornerRadius="3" Background="#0E101A" BorderBrush="#222538" BorderThickness="1" ClipToBounds="True"
                                                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                                                <Image Source="{Binding ItemIcon}" Width="24" Height="24" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding HasItem}" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>

                                                                                <!-- Trinket with Tooltip -->
                                                                                <Border Width="24" Height="24" CornerRadius="3" Background="#0E101A" BorderBrush="#7C3AED" BorderThickness="1" ClipToBounds="True" Margin="3,0,0,0"
                                                                                        ToolTip.Tip="{Binding Trinket.ToolTipText}">
                                                                                    <Image Source="{Binding Trinket.ItemIcon}" Width="24" Height="24" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding Trinket.HasItem}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- TAB 2: TACTICAL REPORT & GAP ANALYSIS -->
                                            <StackPanel Spacing="12" IsVisible="{Binding IsTacticalTabActive}">
                                                <!-- Overall Tactical Verdict & Key Takeaway Banner -->
                                                <Border Background="#141624" CornerRadius="10" BorderBrush="#22263C" BorderThickness="1" Padding="14,12">
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <Border Grid.Column="0" Background="{Binding TacticalReport.MatchGradeColor}" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0">
                                                            <TextBlock Text="{Binding TacticalReport.MatchGrade}" FontSize="20" FontWeight="Bold" Foreground="#0B0C12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TacticalReport.OverallMatchVerdict}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding TacticalReport.KeyTakeaway}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ExportStatusMessage}" FontSize="11" Foreground="#A78BFA" FontWeight="SemiBold" IsVisible="{Binding ExportStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </StackPanel>
                                                        <!-- Export Actions -->
                                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <Button Command="{Binding CopyCoachReportCommand}"
                                                                    Content="📋 Скопіювати звіт"
                                                                    FontSize="11"
                                                                    Background="#181B2B"
                                                                    BorderBrush="#252A42"
                                                                    BorderThickness="1"
                                                                    Foreground="#C4B5FD"
                                                                    FontWeight="SemiBold"
                                                                    Padding="10,5"
                                                                    CornerRadius="6"
                                                                    Cursor="Hand" />
                                                            <Button Command="{Binding SaveCoachReportToFileCommand}"
                                                                    Content="💾 Зберегти у файл"
                                                                    FontSize="11"
                                                                    Background="#181B2B"
                                                                    BorderBrush="#252A42"
                                                                    BorderThickness="1"
                                                                    Foreground="#A78BFA"
                                                                    FontWeight="SemiBold"
                                                                    Padding="10,5"
                                                                    CornerRadius="6"
                                                                    Cursor="Hand" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Comparative Gap Analysis ("Що пішло не так проти стандарту рангу") -->
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="📊 ПОРІВНЯЛЬНИЙ АНАЛІЗ ЗІ СТАНДАРТОМ РАНГУ (GAP ANALYSIS)" FontSize="12" FontWeight="Bold" Foreground="#C4B5FD" LetterSpacing="1.1" />
                                                    <ItemsControl ItemsSource="{Binding TacticalReport.GapAnalysis}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{Binding CardBg}" CornerRadius="8" BorderBrush="{Binding CardBorder}" BorderThickness="1" Padding="12,10" Margin="3,0">
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{Binding MetricName}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                                                        <Grid ColumnDefinitions="*, Auto">
                                                                            <TextBlock Grid.Column="0" Text="{Binding ActualValueText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                            <Border Grid.Column="1" Background="{Binding BadgeBg}" CornerRadius="4" Padding="5,1">
                                                                                <TextBlock Text="{Binding EvaluationText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ImpactColor}" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding BenchmarkValueText}" FontSize="10" Foreground="#64748B" />
                                                                        <TextBlock Text="{Binding Advice}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14" Margin="0,4,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Play-by-play Minute-by-Minute Timeline -->
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Grid.Column="0" Text="⏱️ ПОХВИЛИННИЙ РОЗБІР КЛЮЧОВИХ РІШЕНЬ (PLAY-BY-PLAY)" FontSize="12" FontWeight="Bold" Foreground="#C4B5FD" LetterSpacing="1.1" />
                                                        <TextBlock Grid.Column="1" Text="⏳ Завантаження подій Riot Timeline..." FontSize="11" Foreground="#A78BFA" IsVisible="{Binding IsLoadingTimeline}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding TacticalReport.TimelineEvents}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Classes="tactical-node"
                                                                        Background="{Binding CardBackground}"
                                                                        CornerRadius="8"
                                                                        BorderBrush="{Binding CardBorderColor}"
                                                                        BorderThickness="1"
                                                                        Padding="12,8"
                                                                        Margin="0,3">
                                                                    <Grid ColumnDefinitions="80, 42, *, Auto">
                                                                        <!-- Col 0: Timestamp & Phase -->
                                                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                                            <Border Background="#181B2B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                                                <TextBlock Text="{Binding TimestampText}" FontSize="11" FontWeight="Bold" Foreground="#C4B5FD" />
                                                                            </Border>
                                                                            <Border Background="#141726" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                                                                <TextBlock Text="{Binding PhaseName}" FontSize="8" FontWeight="SemiBold" Foreground="{Binding PhaseBadgeColor}" TextTrimming="CharacterEllipsis" MaxWidth="75" />
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <!-- Col 1: Modern Styled Vector HUD Badge with Icon and Glow -->
                                                                        <Border Grid.Column="1"
                                                                                Width="34" Height="34"
                                                                                CornerRadius="17"
                                                                                Background="{Binding IconBadgeBg}"
                                                                                BorderBrush="{Binding IconBadgeBorder}"
                                                                                BorderThickness="1.5"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                                            <PathIcon Data="{Binding IconPath}"
                                                                                      Width="16" Height="16"
                                                                                      Foreground="{Binding IconBadgeFg}"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                        </Border>

                                                                        <!-- Col 2: Tactical Info, Category tag, Severity tag, and Description -->
                                                                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" Margin="12,0,10,0">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                <!-- Category Tag Pill -->
                                                                                <Border Background="#1B1634" BorderBrush="{Binding CategoryTagColor}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                                                    <TextBlock Text="{Binding CategoryTag}" FontSize="9" FontWeight="Bold" Foreground="{Binding CategoryTagColor}" />
                                                                                </Border>
                                                                                <!-- Severity Tag Pill (Hidden if duplicate) -->
                                                                                <Border Background="{Binding SeverityBg}" CornerRadius="4" Padding="6,1" IsVisible="{Binding HasSeverityTag}">
                                                                                    <TextBlock Text="{Binding SeverityTag}" FontSize="9" FontWeight="Bold" Foreground="{Binding SeverityFg}" />
                                                                                </Border>
                                                                                <!-- Event Title -->
                                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="15" />
                                                                        </StackPanel>

                                                                        <!-- Col 3: Impact Callout Badge -->
                                                                        <Border Grid.Column="3"
                                                                                Background="#181B2B"
                                                                                CornerRadius="6"
                                                                                BorderBrush="{Binding ImpactColor}"
                                                                                BorderThickness="1"
                                                                                Padding="10,4"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ImpactText}"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{Binding ImpactColor}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. LOAD MORE MATCHES BUTTON -->
            <Button Command="{Binding LoadMoreMatchesCommand}"
                    IsEnabled="{Binding !IsLoadingMore}"
                    IsVisible="{Binding CanLoadMore}"
                    Classes="action-btn"
                    Height="42"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Background="#121824"
                    BorderBrush="#252D3D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    Margin="0,4,0,20">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LoadMoreButtonText}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#0AC8B9"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
