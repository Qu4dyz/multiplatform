<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GameAnalytics.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="GameAnalytics.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="18">
            <!-- Header -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Налаштування"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Курсовий проєкт «Мультиплатформне програмування» · ML.NET FastTree, EF Core 9, SQLite"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- API Configuration Card -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Riot API"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <Button Grid.Column="1"
                                Command="{Binding OpenRiotPortalCommand}"
                                Content="Отримати ключ на developer.riotgames.com"
                                FontSize="11"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Foreground="#A78BFA"
                                Padding="10,4"
                                CornerRadius="8"
                                Cursor="Hand" />
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Riot Games Development API Key:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding ApiKey}"
                                 PlaceholderText="RGAPI-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
                                 Height="36"
                                 FontSize="13"
                                 PasswordChar="●" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="4">
                            <TextBlock Text="Ігровий сервер / Регіон:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableRegions}"
                                      SelectedItem="{Binding SelectedRegion}"
                                      Height="36"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                            <TextBlock Text="Бажаний ранг у демо-режимі (якщо без ключа):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableTiers}"
                                      SelectedItem="{Binding SelectedDemoTier}"
                                      Height="36"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding UseMockFallback}"
                              Content="Автоматичний Mock / Demo режим (якщо API-ключ відсутній, недійсний або закінчився його 24-годинний термін)" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding SaveSettingsCommand}"
                                Content="Зберегти налаштування"
                                Height="36"
                                Padding="16,0"
                                Background="#7C3AED"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Cursor="Hand" />

                        <Button Command="{Binding TestConnectionCommand}"
                                Content="Перевірити з'єднання з API"
                                Height="36"
                                Padding="16,0"
                                Background="{StaticResource Surface3Brush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Cursor="Hand" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="#C4B5FD"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Database & Cache Card -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Локальна база даних"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Шлях до файлу БД:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabasePath}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Розмір бази:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseSizeText}" FontSize="12" Foreground="#0AC8B9" FontWeight="SemiBold" />
                    </Grid>

                    <Button Command="{Binding ClearDatabaseCommand}"
                            Content="{Binding ClearDatabaseButtonText}"
                            Height="36"
                            Padding="14,0"
                            Background="{StaticResource BorderBrush}"
                            Foreground="#E84057"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- Platform & Cloud VPS Info Card -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Про систему"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid ColumnDefinitions="160, *" RowDefinitions="Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Поточна ОС клієнта:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OsDescription}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Версія .NET Core:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DotnetVersion, StringFormat='.NET {0}'}" FontSize="12" Foreground="#0AC8B9" FontWeight="Bold" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Віддалений Linux VPS:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VpsHostInfo}" FontSize="12" Foreground="#C8AA6E" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="VPS ML Тренування:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                            <TextBlock Text="dotnet run --project src/GameAnalytics.Desktop --vps-train" FontSize="11" Foreground="#0AC8B9" FontFamily="Consolas, monospace" FontWeight="Bold" />
                            <TextBlock Text="Автономний 24/7 демон для збору рейтингових ігор Riot API та безперервного навчання моделей ML.NET на VPS." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cloud VPS Sync & ML Model Hub Card -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="20" BorderBrush="#0AC8B9" BorderThickness="1.5">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Синхронізація з VPS"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#0AC8B9" />
                            <TextBlock Text="Миттєве отримання свіжих вагів натренованої моделі FastTree та бази реальних ігор з віддаленого сервера в один клік"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding CheckVpsStatusCommand}"
                                Content="Перевірити зв'язок"
                                FontSize="12"
                                Background="{StaticResource Surface3Brush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="12,6"
                                Cursor="Hand" />
                    </Grid>

                    <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="VPS Endpoint URL:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding VpsServerUrl}" Height="34" FontSize="13" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Статус сервера:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VpsStatusBadge}" FontSize="12" FontWeight="SemiBold" Foreground="#0AC8B9" VerticalAlignment="Center" Margin="0,10,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding SyncModelFromVpsCommand}"
                                IsEnabled="{Binding !IsSyncingModel}"
                                Content="Завантажити свіжу ML-модель з VPS"
                                Height="38"
                                Padding="16,0"
                                Background="#7C3AED"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="Bold"
                                Cursor="Hand" />

                        <Button Command="{Binding SyncDatabaseFromVpsCommand}"
                                IsEnabled="{Binding !IsSyncingDatabase}"
                                Content="Синхронізувати базу матчів SQLite"
                                Height="38"
                                Padding="16,0"
                                Background="{StaticResource Surface3Brush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Cursor="Hand" />
                    </StackPanel>

                    <TextBlock Text="{Binding VpsSyncMessage}"
                               FontSize="12"
                               Foreground="#C4B5FD"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
