<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GameAnalytics.Desktop.ViewModels"
             xmlns:entities="using:GameAnalytics.Core.Entities"
             xmlns:conv="using:GameAnalytics.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="950"
             x:Class="GameAnalytics.Desktop.Views.DraftPredictionView"
             x:DataType="vm:DraftPredictionViewModel"
             x:Name="RootControl">

    <UserControl.Styles>
        <Style Selector="Button.role-chip">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.role-chip.active">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="BorderBrush" Value="#A78BFA" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">

            <!-- SECTION 1: 5v5 DRAFT BOARD & CHAMPION PICKER -->
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Драфт 5 на 5"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#C4B5FD" />
                            <TextBlock Text="Оберіть позицію та призначте чемпіона для кожної команди. Вінрейти та синергії оновлюються автоматично."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="8,4" BorderBrush="#7C3AED" BorderThickness="1">
                                <TextBlock Text="{Binding PatchVersion, StringFormat='Патч DDragon: v{0}'}"
                                           FontSize="11"
                                           Foreground="#A78BFA" />
                            </Border>
                            <Button Content="Скинути драфт"
                                    Command="{Binding ResetDraftCommand}"
                                    FontSize="11"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Foreground="#C4B5FD"
                                    Padding="12,6"
                                    CornerRadius="8"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <!-- 5v5 Slots Arena (Blue vs Red) -->
                    <Grid ColumnDefinitions="*, 1.4*, *">
                        <!-- Blue Team Slots (5 rows) -->
                        <Border Grid.Column="0"
                                Background="#0A1428"
                                CornerRadius="8"
                                Padding="12"
                                BorderBrush="#0397AB"
                                BorderThickness="1.5">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="СИНЯ КОМАНДА"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#0AC8B9" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BlueTeamAvgWinRate, StringFormat='{}{0:F1}% WR'}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#0397AB" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding BlueDraftSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DraftSlotViewModel">
                                            <Button Command="{Binding #RootControl.((vm:DraftPredictionViewModel)DataContext).SelectSlotCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="6"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="#0397AB"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="32, 40, *, Auto">
                                                    <!-- Role Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PositionIcon}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />

                                                    <!-- Champion Icon Image -->
                                                    <Border Grid.Column="1"
                                                            Width="34" Height="34"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            Background="#0F1220"
                                                            Margin="4,0">
                                                        <Image conv:RemoteImage.Url="{Binding ChampionIconUrl}"
                                                               Width="34" Height="34"
                                                               Stretch="UniformToFill" />
                                                    </Border>

                                                    <!-- Champion Name & Role -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding ChampionDisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding PositionName}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <!-- Individual Win Rate -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding WinRateText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#0AC8B9"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Center: Champion Picker Console -->
                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="8"
                                Padding="14"
                                Margin="12,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="10">
                                <!-- Active Slot Indicator -->
                                <Border Background="#0F1220" CornerRadius="4" Padding="8,6" BorderBrush="#C8AA6E" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <TextBlock Text="Вибір для: "
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C8AA6E" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ActiveSlot.ChampionDisplayName, FallbackValue='Оберіть слот'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Border>

                                <!-- Search and Role Filter -->
                                <TextBox Text="{Binding SearchQuery}"
                                         PlaceholderText="Пошук чемпіона за ім'ям..."
                                         Height="32"
                                         FontSize="12" />

                                <!-- Role filter chips wrap to a second line instead of a clipped scroll strip -->
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                    <Button Classes="role-chip" Content="Всі"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=All}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="All" />
                                    <Button Classes="role-chip" Content="Боєць"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=Fighter}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="Fighter" />
                                    <Button Classes="role-chip" Content="Маг"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=Mage}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="Mage" />
                                    <Button Classes="role-chip" Content="Вбивця"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=Assassin}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="Assassin" />
                                    <Button Classes="role-chip" Content="Стрілець"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=Marksman}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="Marksman" />
                                    <Button Classes="role-chip" Content="Танк"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=Tank}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="Tank" />
                                    <Button Classes="role-chip" Content="Підтримка"
                                            Classes.active="{Binding SelectedRoleFilter, Converter={x:Static conv:EqualsParameterConverter.Instance}, ConverterParameter=Support}"
                                            Command="{Binding FilterByRoleCommand}" CommandParameter="Support" />
                                </WrapPanel>

                                <!-- Champion Grid / List -->
                                <Border Background="#0F1220"
                                        CornerRadius="4"
                                        Padding="6"
                                        Height="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredChampions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="entities:ChampionInfo">
                                                    <Button Command="{Binding #RootControl.((vm:DraftPredictionViewModel)DataContext).PickChampionCommand}"
                                                            CommandParameter="{Binding}"
                                                            Margin="3"
                                                            Padding="4"
                                                            Width="68" Height="68"
                                                            Background="{StaticResource Surface2Brush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            ToolTip.Tip="{Binding Name}"
                                                            Cursor="Hand">
                                                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                                                            <Border Width="38" Height="38"
                                                                    CornerRadius="4"
                                                                    ClipToBounds="True"
                                                                    Background="#0A1428">
                                                                <Image conv:RemoteImage.Url="{Binding IconUrl}"
                                                                       Width="38" Height="38"
                                                                       Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Red Team Slots (5 rows) -->
                        <Border Grid.Column="2"
                                Background="#0A1428"
                                CornerRadius="8"
                                Padding="12"
                                BorderBrush="#E84057"
                                BorderThickness="1.5">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="ЧЕРВОНА КОМАНДА"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#E84057" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RedTeamAvgWinRate, StringFormat='{}{0:F1}% WR'}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="#E84057" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RedDraftSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DraftSlotViewModel">
                                            <Button Command="{Binding #RootControl.((vm:DraftPredictionViewModel)DataContext).SelectSlotCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="6"
                                                    Margin="0,0,0,6"
                                                    Background="{StaticResource Surface2Brush}"
                                                    BorderBrush="#E84057"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="32, 40, *, Auto">
                                                    <!-- Role Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PositionIcon}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />

                                                    <!-- Champion Icon Image -->
                                                    <Border Grid.Column="1"
                                                            Width="34" Height="34"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            Background="#0F1220"
                                                            Margin="4,0">
                                                        <Image conv:RemoteImage.Url="{Binding ChampionIconUrl}"
                                                               Width="34" Height="34"
                                                               Stretch="UniformToFill" />
                                                    </Border>

                                                    <!-- Champion Name & Role -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding ChampionDisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding PositionName}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>

                                                    <!-- Individual Win Rate -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding WinRateText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#E84057"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 1.5: DRAFT COMPOSITION SCALING & POWER SPIKE CURVES -->
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    Padding="18"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Сила складів по фазах гри"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#C8AA6E" />
                            <TextBlock Text="Автоматичний розрахунок сили піків за фазами гри (Early 0-15m / Mid 15-25m / Late 25m+) та аналіз умов перемоги"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,12,0" />
                        </StackPanel>

                        <!-- Overall Verdict Banner -->
                        <Border Grid.Column="1" Background="#0F1220" CornerRadius="8" Padding="12,6" BorderBrush="#0AC8B9" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PowerSpikes.ComparativeVerdict}"
                                       FontSize="11"
                                       Foreground="#0AC8B9"
                                       MaxWidth="420"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <!-- Side-by-side Blue vs Red Team Power Curves -->
                    <Grid ColumnDefinitions="*, *">
                        <!-- Blue Team Scaling Curve -->
                        <Border Grid.Column="0" Background="#101527" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="#0397AB" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="СИНЯ КОМАНДА — СКЕЙЛІНГ" FontWeight="Bold" FontSize="11" Foreground="#0AC8B9" />
                                    <TextBlock Grid.Column="1" Text="{Binding PowerSpikes.BlueTeam.ArchetypeTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>

                                <!-- Early Game Power -->
                                <Grid ColumnDefinitions="70, *, 40">
                                    <TextBlock Grid.Column="0" Text="Early (0-15m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding PowerSpikes.BlueTeam.EarlyGamePower}" Minimum="0" Maximum="100" Height="8" Foreground="#0AC8B9" Background="#141E2F" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerSpikes.BlueTeam.FormattedEarlyPower}" FontSize="11" FontWeight="Bold" Foreground="#0AC8B9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Mid Game Power -->
                                <Grid ColumnDefinitions="70, *, 40">
                                    <TextBlock Grid.Column="0" Text="Mid (15-25m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding PowerSpikes.BlueTeam.MidGamePower}" Minimum="0" Maximum="100" Height="8" Foreground="#0397AB" Background="#141E2F" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerSpikes.BlueTeam.FormattedMidPower}" FontSize="11" FontWeight="Bold" Foreground="#0397AB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Late Game Power -->
                                <Grid ColumnDefinitions="70, *, 40">
                                    <TextBlock Grid.Column="0" Text="Late (25m+)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding PowerSpikes.BlueTeam.LateGamePower}" Minimum="0" Maximum="100" Height="8" Foreground="#5383E8" Background="#141E2F" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerSpikes.BlueTeam.FormattedLatePower}" FontSize="11" FontWeight="Bold" Foreground="#5383E8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding PowerSpikes.BlueTeam.WinConditionSummary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Red Team Scaling Curve -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="8,0,0,0" BorderBrush="#E84057" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="ЧЕРВОНА КОМАНДА — СКЕЙЛІНГ" FontWeight="Bold" FontSize="11" Foreground="#E84057" />
                                    <TextBlock Grid.Column="1" Text="{Binding PowerSpikes.RedTeam.ArchetypeTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                </Grid>

                                <!-- Early Game Power -->
                                <Grid ColumnDefinitions="70, *, 40">
                                    <TextBlock Grid.Column="0" Text="Early (0-15m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding PowerSpikes.RedTeam.EarlyGamePower}" Minimum="0" Maximum="100" Height="8" Foreground="#E84057" Background="{StaticResource Surface2Brush}" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerSpikes.RedTeam.FormattedEarlyPower}" FontSize="11" FontWeight="Bold" Foreground="#E84057" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Mid Game Power -->
                                <Grid ColumnDefinitions="70, *, 40">
                                    <TextBlock Grid.Column="0" Text="Mid (15-25m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding PowerSpikes.RedTeam.MidGamePower}" Minimum="0" Maximum="100" Height="8" Foreground="#FF5E7E" Background="{StaticResource Surface2Brush}" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerSpikes.RedTeam.FormattedMidPower}" FontSize="11" FontWeight="Bold" Foreground="#FF5E7E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Late Game Power -->
                                <Grid ColumnDefinitions="70, *, 40">
                                    <TextBlock Grid.Column="0" Text="Late (25m+)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding PowerSpikes.RedTeam.LateGamePower}" Minimum="0" Maximum="100" Height="8" Foreground="#FFAA5E" Background="{StaticResource Surface2Brush}" CornerRadius="4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PowerSpikes.RedTeam.FormattedLatePower}" FontSize="11" FontWeight="Bold" Foreground="#FFAA5E" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="{Binding PowerSpikes.RedTeam.WinConditionSummary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 2: EARLY GAME METRICS & ML MODEL RESULTS -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto">
                <!-- Left Column: Input Features & Parameters -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,10,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Стан гри на 15-й хвилині"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#C4B5FD" />

                        <!-- Live Client LoL Bar -->
                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12" BorderBrush="#7C3AED" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Дані з клієнта LoL"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="#A78BFA"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LiveGameStatusText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ScanLiveGameCommand}"
                                            IsEnabled="{Binding !IsCheckingLiveGame}"
                                            Content="Зчитати з LoL (2999)"
                                            Background="#7C3AED"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            FontSize="11"
                                            Padding="12,6"
                                            CornerRadius="8"
                                            Cursor="Hand" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Algorithm Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Активний алгоритм машинного навчання:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <ComboBox ItemsSource="{Binding AvailableAlgorithms}"
                                      SelectedItem="{Binding SelectedAlgorithm}"
                                      HorizontalAlignment="Stretch"
                                      Height="34" />
                        </StackPanel>

                        <!-- Quick Preset Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Баланс (50/50)"
                                    Command="{Binding ResetToBalancedCommand}"
                                    FontSize="12"
                                    Background="{StaticResource Surface3Brush}"
                                    Padding="10,6"
                                    Cursor="Hand" />
                            <Button Content="Перевага Синіх"
                                    Command="{Binding SetBlueAdvantagePresetCommand}"
                                    FontSize="12"
                                    Background="#0397AB"
                                    Foreground="White"
                                    Padding="10,6"
                                    Cursor="Hand" />
                            <Button Content="Перевага Червоних"
                                    Command="{Binding SetRedAdvantagePresetCommand}"
                                    FontSize="12"
                                    Background="#E84057"
                                    Foreground="White"
                                    Padding="10,6"
                                    Cursor="Hand" />
                        </StackPanel>

                        <Separator Background="{StaticResource Surface3Brush}" Height="1" />

                        <!-- Key Objective Checkboxes -->
                        <TextBlock Text="Ключові об'єкти ранньої стадії (ранні прапорці):"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <CheckBox IsChecked="{Binding BlueFirstBlood}"
                                  Content="Перша кров (First Blood): Синя команда" />
                        <CheckBox IsChecked="{Binding BlueFirstTower}"
                                  Content="Перша вежа (First Tower): Синя команда" />
                        <CheckBox IsChecked="{Binding BlueFirstDragon}"
                                  Content="Перший дракон (First Dragon): Синя команда" />

                        <Separator Background="{StaticResource Surface3Brush}" Height="1" />

                        <!-- Gold Diff Slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Різниця за золотом на 15 хв (Gold Diff):"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GoldDiffAt15, StringFormat='{}{0:+0;-#;0} gold'}"
                                           FontWeight="Bold"
                                           Foreground="#C8AA6E" />
                            </Grid>
                            <Slider Minimum="-6000" Maximum="6000"
                                    Value="{Binding GoldDiffAt15}"
                                    SmallChange="250" LargeChange="1000" />
                        </StackPanel>

                        <!-- Kill Diff Slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Різниця у вбивствах на 15 хв (Kill Diff):"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding KillDiffAt15, StringFormat='{}{0:+0;-#;0} kills'}"
                                           FontWeight="Bold"
                                           Foreground="#0AC8B9" />
                            </Grid>
                            <Slider Minimum="-15" Maximum="15"
                                    Value="{Binding KillDiffAt15}"
                                    SmallChange="1" LargeChange="3" />
                        </StackPanel>

                        <!-- Towers and Dragons Sliders -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                <TextBlock Text="{Binding BlueTowerCount, StringFormat='Вежі Синіх: {0}'}" FontSize="12" Foreground="#0397AB" />
                                <Slider Minimum="0" Maximum="5" Value="{Binding BlueTowerCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                <TextBlock Text="{Binding RedTowerCount, StringFormat='Вежі Червоних: {0}'}" FontSize="12" Foreground="#E84057" />
                                <Slider Minimum="0" Maximum="5" Value="{Binding RedTowerCount}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                <TextBlock Text="{Binding BlueDragonCount, StringFormat='Дракони Синіх: {0}'}" FontSize="12" Foreground="#0397AB" />
                                <Slider Minimum="0" Maximum="4" Value="{Binding BlueDragonCount}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                <TextBlock Text="{Binding RedDragonCount, StringFormat='Дракони Червоних: {0}'}" FontSize="12" Foreground="#E84057" />
                                <Slider Minimum="0" Maximum="4" Value="{Binding RedDragonCount}" />
                            </StackPanel>
                        </Grid>

                        <!-- Voidgrubs and Heralds Sliders -->
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                <TextBlock Text="{Binding BlueVoidgrubs, StringFormat='Личинки Синіх: {0}'}" FontSize="12" Foreground="#0397AB" />
                                <Slider Minimum="0" Maximum="6" Value="{Binding BlueVoidgrubs}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                <TextBlock Text="{Binding RedVoidgrubs, StringFormat='Личинки Червоних: {0}'}" FontSize="12" Foreground="#E84057" />
                                <Slider Minimum="0" Maximum="6" Value="{Binding RedVoidgrubs}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                                <TextBlock Text="{Binding BlueHeralds, StringFormat='Герольд Синіх: {0}'}" FontSize="12" Foreground="#0397AB" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding BlueHeralds}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                                <TextBlock Text="{Binding RedHeralds, StringFormat='Герольд Червоних: {0}'}" FontSize="12" Foreground="#E84057" />
                                <Slider Minimum="0" Maximum="1" Value="{Binding RedHeralds}" />
                            </StackPanel>
                        </Grid>

                        <!-- CS Diff Slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Різниця фарму міньйонів на 15 хв (CS Diff):"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CsDiffAt15, StringFormat='{}{0:+0;-#;0} CS'}"
                                           FontWeight="Bold"
                                           Foreground="#0AC8B9" />
                            </Grid>
                            <Slider Minimum="-100" Maximum="100"
                                    Value="{Binding CsDiffAt15}"
                                    SmallChange="5" LargeChange="20" />
                        </StackPanel>

                        <!-- XP Diff Slider -->
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Різниця командного досвіду на 15 хв (XP Diff):"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding XpDiffAt15, StringFormat='{}{0:+0;-#;0} XP'}"
                                           FontWeight="Bold"
                                           Foreground="#C8AA6E" />
                            </Grid>
                            <Slider Minimum="-4000" Maximum="4000"
                                    Value="{Binding XpDiffAt15}"
                                    SmallChange="250" LargeChange="1000" />
                        </StackPanel>

                        <!-- Lobby rank context -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10" BorderBrush="#7C3AED" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ранг лобі" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                                <TextBlock Text="Той самий голд-лід інакше конвертується в Iron і в Challenger"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                <ComboBox ItemsSource="{Binding AvailableLobbyTiers}"
                                          SelectedItem="{Binding SelectedLobbyTier}"
                                          HorizontalAlignment="Stretch"
                                          Height="32" />
                            </StackPanel>
                        </Border>

                        <!-- Dragon Soul Settings -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10" BorderBrush="#C8AA6E" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Драконяча душа" FontSize="11" FontWeight="Bold" Foreground="#C8AA6E" />
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="2">
                                        <TextBlock Text="Тип душі:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <ComboBox ItemsSource="{Binding AvailableSoulTypes}"
                                                  SelectedItem="{Binding SelectedSoulType}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="2">
                                        <TextBlock Text="Власник душі (4 дракони):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <ComboBox ItemsSource="{Binding AvailableSides}"
                                                  SelectedItem="{Binding SoulOwner}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="32" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Run Prediction Button -->
                        <Button Command="{Binding CalculatePredictionCommand}"
                                Content="Розрахувати шанс перемоги"
                                Height="44"
                                Background="#7C3AED"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontWeight="Bold"
                                FontSize="13"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand" />
                    </StackPanel>
                </Border>

                <!-- Right Column: ML Prediction Result Card -->
                <Border Grid.Column="1"
                        Background="{StaticResource Surface2Brush}"
                        CornerRadius="8"
                        Padding="20"
                        Margin="10,0,0,0"
                        BorderBrush="#C8AA6E"
                        BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Прогноз"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#C8AA6E" />

                        <!-- Big Chances Board -->
                        <Grid ColumnDefinitions="*, Auto, *" Margin="0,6">
                            <!-- Blue Side -->
                            <Border Grid.Column="0"
                                    Background="#0A1428"
                                    CornerRadius="8"
                                    Padding="16"
                                    BorderBrush="#0397AB"
                                    BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="СИНЯ КОМАНДА"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#0AC8B9" />
                                    <TextBlock Text="{Binding Prediction.FormattedBluePercent}"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#5383E8"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Ймовірність перемоги"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="VS"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0" />

                            <!-- Red Side -->
                            <Border Grid.Column="2"
                                    Background="#0A1428"
                                    CornerRadius="8"
                                    Padding="16"
                                    BorderBrush="#E84057"
                                    BorderThickness="2">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="ЧЕРВОНА КОМАНДА"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#E84057" />
                                    <TextBlock Text="{Binding Prediction.FormattedRedPercent}"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#E84057"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Ймовірність перемоги"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Prediction Banner -->
                        <Border Background="#0F1220"
                                CornerRadius="8"
                                Padding="14"
                                BorderBrush="{StaticResource Surface3Brush}"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ймовірний переможець:"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Prediction.PredictedWinner, StringFormat='Перемога: {0} Team'}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#0AC8B9" />
                                <ProgressBar Value="{Binding Prediction.BlueWinProbability}"
                                             Minimum="0"
                                             Maximum="1"
                                             Height="10"
                                             Foreground="#0397AB"
                                             Background="#E84057" />
                            </StackPanel>
                        </Border>

                        <!-- Key Influencing Factors -->
                        <TextBlock Text="Що найбільше впливає:"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#C8AA6E" />

                        <ItemsControl ItemsSource="{Binding Prediction.KeyFactors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F1220"
                                            CornerRadius="4"
                                            Padding="10,6"
                                            Margin="0,0,0,6"
                                            BorderBrush="{StaticResource Surface3Brush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource Surface3Brush}" Height="1" />

                        <!-- Model Training on Real Data Bar -->
                        <Border Background="#101726" CornerRadius="8" Padding="12,10" BorderBrush="#1F2D44" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding TrainingStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#0AC8B9" TextWrapping="Wrap" />
                                <Button Command="{Binding RetrainOnRealDataCommand}"
                                        IsEnabled="{Binding !IsRetraining}"
                                        Content="Перенавчити модель на реальних матчах з бази"
                                        Height="34"
                                        Background="{StaticResource Surface3Brush}"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Benchmark Section -->
                        <Button Command="{Binding RunBenchmarkCommand}"
                                Content="Запустити бенчмарк 3-х алгоритмів (ML.NET)"
                                Height="38"
                                Background="{StaticResource Surface3Brush}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontWeight="Bold"
                                FontSize="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand" />

                        <Border Background="#0F1220"
                                CornerRadius="8"
                                Padding="12"
                                BorderBrush="#C8AA6E"
                                BorderThickness="1"
                                IsVisible="{Binding BenchmarkReport, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Порівняння алгоритмів"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Foreground="#C8AA6E" />

                                <TextBlock Text="{Binding BenchmarkReport.BestModelByAuc, StringFormat='Кращий за AUC-ROC: {0}'}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#0AC8B9" />

                                <ItemsControl ItemsSource="{Binding BenchmarkReport.Models}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Surface2Brush}"
                                                    CornerRadius="4"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding AlgorithmName}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FormattedAccuracy, StringFormat='Acc: {0}'}"
                                                               FontSize="11"
                                                               Foreground="#0AC8B9"
                                                               Margin="8,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding FormattedAuc, StringFormat='AUC: {0}'}"
                                                               FontSize="11"
                                                               Foreground="#C8AA6E"
                                                               Margin="8,0" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding TrainingDurationMs, StringFormat='{}{0}ms'}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
